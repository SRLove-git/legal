.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  z-index: 9990;
}

.header-inner {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo-wrap {
  flex-shrink: 0;
}

.logo {
  width: 164rpx;
  height: auto;
}

.ai-pill {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 58rpx;
  padding: 4rpx 5rpx 4rpx 22rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 999rpx;
  background: #ffffff;
  flex: 1;
  margin: 0 16rpx;
  max-width: 330rpx;
}

.ai-pill-prompt {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #666666;
  font-size: 23rpx;
  font-weight: 400;
  line-height: 50rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ai-pill-caret {
  margin-left: 3rpx;
  color: #0084ba;
  font-weight: 400;
}

.ai-pill-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  flex: 0 0 50rpx;
  border-radius: 50%;
  background: #0084ba;
}

.ai-pill-icon {
  display: flex;
  align-items: center;
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  position: relative;
}

.ai-pill-icon::after {
  content: "";
  position: absolute;
  right: -7rpx;
  bottom: -5rpx;
  width: 11rpx;
  height: 3rpx;
  background: #ffffff;
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.ai-pill-text {
  display: none;
}

.menu-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.menu-label {
  font-size: 18rpx;
  color: #333333;
}

.menu-lines {
  width: 36rpx;
}

.menu-line {
  height: 3rpx;
  background: #333333;
  margin-bottom: 6rpx;
  border-radius: 2rpx;
}

.drawer-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 9991;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.drawer-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.drawer {
  position: fixed;
  top: 0;
  right: auto;
  left: 0;
  bottom: 0;
  width: 78%;
  max-width: 600rpx;
  background: #ffffff;
  z-index: 9992;
  transform: translateX(-100%);
  transition: transform 0.28s ease;
  padding-left: 36rpx;
  padding-right: 36rpx;
  padding-bottom: 32rpx;
  overflow-y: auto;
}

.drawer.open {
  transform: translateX(0);
}

.drawer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.drawer-logo {
  width: 200rpx;
  height: auto;
}

.drawer-close {
  font-size: 40rpx;
  color: #333333;
}

.drawer-search {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.drawer-search-input {
  flex: 1;
  height: 72rpx;
  border: 2rpx solid #0084ba;
  border-radius: 36rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
}

.drawer-search-btn {
  margin-left: 16rpx;
  color: #ffffff;
  background: #0084ba;
  border-radius: 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
}

.drawer-nav-item {
  padding: 28rpx 0;
  font-size: 30rpx;
  color: #2d2d2d;
  border-bottom: 1rpx solid #e8e8e8;
}

.drawer-nav-group {
  border-bottom: 1rpx solid #e8e8e8;
}

.drawer-nav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.drawer-nav-parent {
  flex: 1;
  min-width: 0;
  border-bottom: 0;
}

.drawer-nav-toggle {
  width: 104rpx;
  min-height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.drawer-nav-chevron {
  width: 18rpx;
  height: 18rpx;
  border-right: 3rpx solid #9ca3af;
  border-bottom: 3rpx solid #9ca3af;
  transform: rotate(45deg);
  transform-origin: center;
  transition: transform 0.28s ease, border-color 0.28s ease;
}

.drawer-nav-chevron.open {
  transform: rotate(-135deg);
  border-color: #6b7280;
}

.drawer-subnav {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.28s ease, padding-bottom 0.28s ease;
}

.drawer-subnav.open {
  max-height: 300rpx;
  padding-bottom: 8rpx;
}

.drawer-subnav-item {
  padding: 20rpx 40rpx;
  color: #303030;
  font-size: 28rpx;
  line-height: 1.45;
}

.drawer-subnav-item:active {
  color: #0084ba;
  background: #f8fafc;
}
