<view class="header" style="padding-top:{{statusBarHeight}}px;">
  <view class="header-inner" style="padding-left:36rpx;padding-right:{{headerRightPadding}}px;">
    <view class="menu-button" bindtap="toggleMenu">
      <text class="menu-label">Menu</text>
      <view class="menu-lines">
        <view class="menu-line"></view>
        <view class="menu-line"></view>
        <view class="menu-line"></view>
      </view>
    </view>

    <view class="logo-wrap" bindtap="goHome">
      <image class="logo" src="https://www.legaloneglobal.com/images/Logo2.s.png" mode="widthFix" />
    </view>

    <view class="ai-pill" bindtap="goAi">
      <view class="ai-pill-prompt">{{aiPrompt}}<text class="ai-pill-caret">|</text></view>
      <view class="ai-pill-action"><view class="ai-pill-icon"></view></view>
    </view>
  </view>
</view>

<view class="drawer-mask {{menuOpen ? 'show' : ''}}" bindtap="closeMenu"></view>
<view class="drawer {{menuOpen ? 'open' : ''}}" style="padding-top:calc(96rpx + {{statusBarHeight}}px);">
  <view class="drawer-head">
    <image class="drawer-logo" src="https://www.legaloneglobal.com/images/Logo2.s.png" mode="widthFix" />
    <view class="drawer-close" bindtap="closeMenu">✕</view>
  </view>
  <view class="drawer-search">
    <input
      class="drawer-search-input"
      type="text"
      placeholder="Search LegalOne"
      confirm-type="search"
      value="{{keyword}}"
      bindinput="onKeyword"
      bindconfirm="onSearch"
    />
    <view class="drawer-search-btn" bindtap="onSearch">Search</view>
  </view>
  <view class="drawer-nav">
    <block wx:for="{{nav}}" wx:for-item="navItem" wx:key="label">
      <view class="drawer-nav-group" wx:if="{{navItem.children}}">
        <view class="drawer-nav-row">
          <view
            class="drawer-nav-item drawer-nav-parent"
            data-path="{{navItem.path}}"
            bindtap="onNav"
          >{{navItem.label}}</view>
          <view
            class="drawer-nav-toggle"
            bindtap="toggleDealsMenu"
            aria-label="{{dealsMenuOpen ? 'Hide Deals / Cases submenu' : 'Show Deals / Cases submenu'}}"
          >
            <view class="drawer-nav-chevron {{dealsMenuOpen ? 'open' : ''}}"></view>
          </view>
        </view>
        <view class="drawer-subnav {{dealsMenuOpen ? 'open' : ''}}">
          <view
            class="drawer-subnav-item"
            wx:for="{{navItem.children}}"
            wx:for-item="childItem"
            wx:key="label"
            data-path="{{childItem.path}}"
            bindtap="onNav"
          >{{childItem.label}}</view>
        </view>
      </view>
      <view
        class="drawer-nav-item"
        wx:else
        data-path="{{navItem.path}}"
        bindtap="onNav"
      >{{navItem.label}}</view>
    </block>
    <view class="drawer-nav-item" wx:if="{{loggedIn}}" bindtap="goAccount">Account</view>
    <view class="drawer-nav-item" wx:if="{{loggedIn}}" bindtap="goLogout">Logout</view>
    <view class="drawer-nav-item" wx:else bindtap="goLogin">Login</view>
  </view>
</view>
