@import "../../styles/content-actions.wxss";

.detail {
  padding: 0 36rpx 60rpx;
}

.ann-type {
  display: inline-block;
  min-width: 80rpx;
  margin: 0 14rpx 10rpx 0;
  padding: 6rpx 12rpx;
  background: #f2f2f2;
  color: #555555;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 1.2;
  text-align: center;
}

.ann-headline {
  padding: 22rpx 0;
  color: #2d2d2d;
  font-size: 54rpx;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 1.3rpx;
  word-break: break-word;
}

.ann-headline-link {
  color: #0084ba;
}

.ann-date {
  padding-bottom: 20rpx;
  color: #2d2d2d;
  font-size: 28rpx;
  font-weight: 400;
}

.ann-image {
  display: block;
  width: 100%;
  height: auto;
  margin: 20rpx 0;
  background: #eef4f8;
}

.ann-body {
  color: #303030;
  font-size: 36rpx;
  font-weight: 400;
  line-height: 60rpx;
  white-space: pre-wrap;
  word-break: break-word;
}

.ann-rich {
  display: block;
  overflow: hidden;
  color: #303030;
  font-size: 36rpx;
  font-weight: 400;
  line-height: 60rpx;
  word-break: break-word;
}

.ann-original {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 220rpx;
  margin-top: 42rpx;
  padding: 15rpx 32rpx;
  border: 2rpx solid #0084ba;
  border-radius: 40rpx;
  color: #0084ba;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.35;
}

.announcement-state {
  min-height: 280rpx;
  padding: 40rpx 36rpx 80rpx;
  color: #777777;
  font-size: 28rpx;
  line-height: 1.5;
  text-align: center;
}
