.detail {
  padding: 30rpx 36rpx 60rpx;
}

.ann-type {
  font-size: 26rpx;
  color: #0084ba;
  margin-bottom: 14rpx;
}

.ann-headline {
  font-size: 38rpx;
  font-weight: 700;
  color: #2d2d2d;
  line-height: 1.3;
}

.ann-date {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #777777;
}

.ann-body {
  margin-top: 28rpx;
  font-size: 28rpx;
  color: #2d2d2d;
  line-height: 1.65;
  white-space: pre-wrap;
}

.ann-rich {
  display: block;
  margin-top: 28rpx;
  color: #303030;
  font-size: 32rpx;
  line-height: 1.5;
  overflow: hidden;
}

.ann-link {
  display: inline-block;
  margin-top: 28rpx;
  background: #0084ba;
  color: #ffffff;
  border-radius: 8rpx;
  padding: 14rpx 28rpx;
  font-size: 27rpx;
}
