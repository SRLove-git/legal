<site-header />
<view class="subpage" wx:if="{{item}}" style="padding-top:calc(88rpx + {{statusBarHeight}}px);">
  <view class="breadcrumb">
    <image class="breadcrumb-icon" src="/assets/img/court-icon.png" bindtap="goHome" />
    <text class="breadcrumb-sep">></text>
    <text class="breadcrumb-text" bindtap="goCrumb" data-url="/pages/lawfirms/lawfirms">Law Firms</text>
    <text class="breadcrumb-sep">></text>
    <text class="breadcrumb-current">{{item.name}}</text>
  </view>
  <view class="detail">
    <view class="firm-updated" wx:if="{{item.updated}}">Last updated: {{item.updated}}</view>
    <view class="firm-logo-box">
      <image class="firm-logo" src="{{item.image}}" mode="aspectFit" />
    </view>
    <view class="firm-name">{{item.name}}</view>
    <view class="firm-established" wx:if="{{item.established}}">Established in {{item.established}}</view>
    <view class="firm-website" wx:if="{{item.website}}">{{item.website}}</view>
    <view class="firm-stats" wx:if="{{item.numOfLawyer || item.numOfPartner || item.numOfOffice}}">
      <text wx:if="{{item.numOfLawyer}}">Lawyers: {{item.numOfLawyer}}</text>
      <text wx:if="{{item.numOfPartner}}"> · Partners: {{item.numOfPartner}}</text>
      <text wx:if="{{item.numOfOffice}}"> · Offices: {{item.numOfOffice}}</text>
    </view>
    <view class="firm-loc" wx:if="{{item.location}}">{{item.location}}</view>

    <view class="firm-section" wx:if="{{item.overview}}">
      <view class="firm-section-title">Overview</view>
      <rich-text class="firm-rich" wx:if="{{item.overviewHtml}}" nodes="{{item.overviewHtml}}"></rich-text>
      <view class="firm-overview" wx:else>{{item.overview}}</view>
    </view>
    <view class="firm-section" wx:if="{{item.offices.length}}">
      <view class="firm-section-title">Offices</view>
      <view class="firm-list-item" wx:for="{{item.offices}}" wx:key="*this">{{item}}</view>
    </view>
    <view class="firm-section" wx:if="{{item.industries.length}}">
      <view class="firm-section-title">Practice areas</view>
      <view class="firm-list-item" wx:for="{{item.industries}}" wx:key="*this">{{item}}</view>
    </view>
    <view class="firm-section" wx:if="{{item.contacts.length}}">
      <view class="firm-section-title">Contact</view>
      <view class="firm-list-item" wx:for="{{item.contacts}}" wx:key="*this">{{item}}</view>
    </view>

    <view class="firm-section" wx:if="{{lawyers.length}}">
      <view class="firm-section-title">Lawyers</view>
      <view class="firm-list-item" wx:for="{{lawyers}}" wx:key="id" bindtap="goLawyer" data-id="{{item.id}}" data-name="{{item.name}}">{{item.name}}</view>
    </view>
    <view class="firm-section" wx:if="{{cases.length}}">
      <view class="firm-section-title">Cases / deals</view>
      <view class="firm-list-item" wx:for="{{cases}}" wx:key="id" bindtap="goDeal" data-id="{{item.id}}" data-title="{{item.title}}">{{item.title}}</view>
    </view>
    <view class="firm-section" wx:if="{{honours.length}}">
      <view class="firm-section-title">Honours</view>
      <view class="firm-list-item" wx:for="{{honours}}" wx:key="id" bindtap="goArticle" data-id="{{item.id}}" data-title="{{item.title}}">{{item.title}}</view>
    </view>
  </view>
</view>
<site-footer />
