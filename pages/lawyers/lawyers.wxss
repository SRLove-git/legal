.lawyers-page {
  background: #ffffff;
}

.lawyer-filter-toggle {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 86rpx;
  padding: 18rpx 36rpx;
  background: #edebeb;
  color: #202020;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.4;
}

.filter-count {
  min-width: 34rpx;
  height: 34rpx;
  margin-left: 12rpx;
  padding: 0 8rpx;
  border-radius: 17rpx;
  background: #0084ba;
  color: #ffffff;
  font-size: 21rpx;
  line-height: 34rpx;
  text-align: center;
}

.filter-chevron,
.field-chevron {
  width: 0;
  height: 0;
  border-left: 9rpx solid transparent;
  border-right: 9rpx solid transparent;
  border-top: 12rpx solid #777777;
}

.filter-chevron {
  position: absolute;
  right: 82rpx;
  top: 38rpx;
  transition: transform 0.2s ease;
}

.filter-chevron.open {
  transform: rotate(180deg);
}

.lawyer-filter-panel {
  padding: 28rpx 36rpx 34rpx;
  border-bottom: 2rpx solid #d9d9d9;
  background: #f6f6f6;
}

.lawyer-filter-picker {
  display: block;
  margin-bottom: 18rpx;
}

.lawyer-filter-field,
.lawyer-search-field {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 76rpx;
  padding: 0 74rpx 0 24rpx;
  border: 2rpx solid #bcbcbc;
  background: #ffffff;
  color: #333333;
  font-size: 26rpx;
  line-height: 1.35;
}

.lawyer-filter-field.active {
  border-color: #0084ba;
  color: #0084ba;
}

.field-chevron {
  position: absolute;
  right: 26rpx;
  top: 31rpx;
}

.lawyer-search-field {
  margin-bottom: 18rpx;
}

.lawyer-search-field input {
  width: 100%;
  height: 72rpx;
  font-size: 26rpx;
}

.lawyer-filter-actions {
  display: flex;
  gap: 18rpx;
  padding-top: 2rpx;
}

.lawyer-filter-button {
  flex: 1;
  height: 72rpx;
  border: 2rpx solid #0084ba;
  color: #0084ba;
  font-size: 27rpx;
  line-height: 68rpx;
  text-align: center;
}

.lawyer-filter-button.primary {
  background: #0084ba;
  color: #ffffff;
}

.lawyer-list-body {
  padding: 34rpx 26rpx 68rpx;
}

.lawyer-heading-accent {
  width: 76rpx;
  height: 4rpx;
  margin-bottom: 10rpx;
  background: #0084ba;
}

.lawyer-list-heading {
  margin-bottom: 58rpx;
  color: #202020;
  font-size: 53rpx;
  font-weight: 400;
  line-height: 1.12;
  letter-spacing: -1rpx;
}

.lawyer-card {
  overflow: hidden;
  margin-bottom: 34rpx;
  padding: 28rpx 24rpx 0;
  border: 3rpx solid #c8c8c8;
  border-radius: 10rpx;
  background: #ffffff;
  color: #171717;
}

.lawyer-profile {
  display: flex;
  align-items: flex-start;
  gap: 28rpx;
}

.lawyer-photo {
  width: 258rpx;
  height: 386rpx;
  flex: 0 0 258rpx;
  background: #edebeb;
}

.lawyer-photo.placeholder {
  position: relative;
}

.lawyer-photo.placeholder::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  background: #d5d5d5;
  transform: translate(-50%, -50%);
}

.lawyer-profile-detail {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
}

.lawyer-name,
.lawyer-local-name,
.lawyer-firm,
.lawyer-location {
  color: #0084ba;
}

.lawyer-name {
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.25;
}

.lawyer-local-name {
  margin-top: 8rpx;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.25;
}

.lawyer-verified {
  display: block;
  width: 170rpx;
  height: auto;
  margin-top: 16rpx;
}

.lawyer-positions {
  margin: 14rpx 0 12rpx;
}

.lawyer-position {
  display: table;
  max-width: 100%;
  margin-bottom: 8rpx;
  padding: 7rpx 11rpx;
  border-radius: 8rpx;
  background: #0084ba;
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.25;
}

.lawyer-firm,
.lawyer-location,
.lawyer-contact {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.32;
  word-break: break-word;
}

.lawyer-firm {
  font-weight: 500;
}

.lawyer-contact {
  color: #171717;
}

.lawyer-metrics-title {
  margin-top: 32rpx;
  color: #00558d;
  font-size: 31rpx;
  font-weight: 500;
  line-height: 1.3;
}

.lawyer-metric-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 58rpx;
  font-size: 25rpx;
  line-height: 1.3;
}

.lawyer-metric-row.metric-total {
  margin-top: 6rpx;
}

.metric-label {
  display: flex;
  align-items: center;
}

.merit-icon {
  width: 44rpx;
  height: 60rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.metric-value {
  min-width: 78rpx;
  box-sizing: border-box;
  padding: 5rpx 14rpx;
  border-radius: 8rpx;
  background: #00558d;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
}

.metric-unavailable {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 44rpx;
  padding: 0;
  overflow: hidden;
}

.metric-unavailable image {
  display: block;
  width: 10rpx;
  height: 4rpx;
  flex: 0 0 10rpx;
}

.lawyer-testimonials-title {
  margin-top: 28rpx;
  color: #00558d;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.4;
}

.testimonials-total {
  color: #171717;
  font-weight: 600;
}

.metric-value.testimonial-value {
  border: 2rpx solid #99cee3;
  background: #ffffff;
  color: #00558d;
}

.lawyer-loading,
.lawyer-list-end {
  padding: 28rpx 0;
  color: #777777;
  font-size: 25rpx;
  text-align: center;
}
