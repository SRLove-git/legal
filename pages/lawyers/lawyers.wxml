<site-header />
<view class="subpage lawyers-page" style="padding-top:calc(88rpx + {{statusBarHeight}}px);">
  <view class="breadcrumb">
    <image class="breadcrumb-icon" src="https://www.legaloneglobal.com/images/court-icon-4@2x.png" bindtap="goHome" />
    <text class="breadcrumb-sep">></text>
    <text class="breadcrumb-text">Lawyers</text>
  </view>

  <view class="lawyer-filter-toggle" bindtap="toggleFilters">
    <text>{{sortFilterLabel}}</text>
    <text class="filter-count" wx:if="{{activeFilterCount}}">{{activeFilterCount}}</text>
    <view class="filter-chevron {{filtersOpen ? 'open' : ''}}"></view>
  </view>

  <view class="lawyer-filter-panel" wx:if="{{filtersOpen}}">
    <view class="lawyer-filter-picker filter-dropdown-group">
      <view class="lawyer-filter-field filter-dropdown-field {{admissionIndex ? 'active is-active' : ''}} {{openSelect === 'admission' ? 'is-open' : ''}}" bindtap="toggleSelect" data-filter="admission">
        <text class="filter-dropdown-field-label">{{admissionOptions[admissionIndex]}}</text><view class="filter-dropdown-chevron {{openSelect === 'admission' ? 'is-open' : ''}}"></view>
      </view>
      <view class="filter-dropdown-popup" wx:if="{{openSelect === 'admission'}}"><scroll-view class="filter-dropdown-scroll" scroll-y="true" enhanced="true" show-scrollbar="false" style="height: {{admissionOptions.length > 5 ? 360 : admissionOptions.length * 68}}rpx;"><view class="filter-dropdown-option {{index === admissionIndex ? 'is-selected' : ''}}" wx:for="{{admissionOptions}}" wx:key="*this" bindtap="onSelectOption" data-filter="admission" data-index="{{index}}"><text class="filter-dropdown-option-text">{{item}}</text></view></scroll-view></view>
    </view>
    <view class="lawyer-filter-picker filter-dropdown-group">
      <view class="lawyer-filter-field filter-dropdown-field {{positionIndex ? 'active is-active' : ''}} {{openSelect === 'position' ? 'is-open' : ''}}" bindtap="toggleSelect" data-filter="position">
        <text class="filter-dropdown-field-label">{{positionOptions[positionIndex]}}</text><view class="filter-dropdown-chevron {{openSelect === 'position' ? 'is-open' : ''}}"></view>
      </view>
      <view class="filter-dropdown-popup" wx:if="{{openSelect === 'position'}}"><scroll-view class="filter-dropdown-scroll" scroll-y="true" enhanced="true" show-scrollbar="false" style="height: {{positionOptions.length > 5 ? 360 : positionOptions.length * 68}}rpx;"><view class="filter-dropdown-option {{index === positionIndex ? 'is-selected' : ''}}" wx:for="{{positionOptions}}" wx:key="*this" bindtap="onSelectOption" data-filter="position" data-index="{{index}}"><text class="filter-dropdown-option-text">{{item}}</text></view></scroll-view></view>
    </view>
    <view class="lawyer-filter-picker filter-dropdown-group">
      <view class="lawyer-filter-field filter-dropdown-field {{languageIndex ? 'active is-active' : ''}} {{openSelect === 'language' ? 'is-open' : ''}}" bindtap="toggleSelect" data-filter="language">
        <text class="filter-dropdown-field-label">{{languageOptions[languageIndex]}}</text><view class="filter-dropdown-chevron {{openSelect === 'language' ? 'is-open' : ''}}"></view>
      </view>
      <view class="filter-dropdown-popup" wx:if="{{openSelect === 'language'}}"><scroll-view class="filter-dropdown-scroll" scroll-y="true" enhanced="true" show-scrollbar="false" style="height: {{languageOptions.length > 5 ? 360 : languageOptions.length * 68}}rpx;"><view class="filter-dropdown-option {{index === languageIndex ? 'is-selected' : ''}}" wx:for="{{languageOptions}}" wx:key="*this" bindtap="onSelectOption" data-filter="language" data-index="{{index}}"><text class="filter-dropdown-option-text">{{item}}</text></view></scroll-view></view>
    </view>
    <view class="lawyer-filter-picker filter-dropdown-group">
      <view class="lawyer-filter-field filter-dropdown-field {{areaIndex ? 'active is-active' : ''}} {{openSelect === 'area' ? 'is-open' : ''}}" bindtap="toggleSelect" data-filter="area">
        <text class="filter-dropdown-field-label">{{areaOptions[areaIndex]}}</text><view class="filter-dropdown-chevron {{openSelect === 'area' ? 'is-open' : ''}}"></view>
      </view>
      <view class="filter-dropdown-popup" wx:if="{{openSelect === 'area'}}"><scroll-view class="filter-dropdown-scroll" scroll-y="true" enhanced="true" show-scrollbar="false" style="height: {{areaOptions.length > 5 ? 360 : areaOptions.length * 68}}rpx;"><view class="filter-dropdown-option {{index === areaIndex ? 'is-selected' : ''}}" wx:for="{{areaOptions}}" wx:key="*this" bindtap="onSelectOption" data-filter="area" data-index="{{index}}"><text class="filter-dropdown-option-text">{{item}}</text></view></scroll-view></view>
    </view>
    <view class="lawyer-search-field">
      <input placeholder="Search by name / keyword" value="{{keyword}}" bindinput="onInput" bindconfirm="onSearch" confirm-type="search" />
      <view class="search-icon" bindtap="onSearch"></view>
    </view>
    <view class="lawyer-filter-picker filter-dropdown-group">
      <view class="lawyer-filter-field filter-dropdown-field {{sortIndex ? 'active is-active' : ''}} {{openSelect === 'sort' ? 'is-open' : ''}}" bindtap="toggleSelect" data-filter="sort">
        <text class="filter-dropdown-field-label">{{sortOptions[sortIndex]}}</text><view class="filter-dropdown-chevron {{openSelect === 'sort' ? 'is-open' : ''}}"></view>
      </view>
      <view class="filter-dropdown-popup" wx:if="{{openSelect === 'sort'}}"><scroll-view class="filter-dropdown-scroll" scroll-y="true" enhanced="true" show-scrollbar="false" style="height: {{sortOptions.length > 5 ? 360 : sortOptions.length * 68}}rpx;"><view class="filter-dropdown-option {{index === sortIndex ? 'is-selected' : ''}}" wx:for="{{sortOptions}}" wx:key="*this" bindtap="onSelectOption" data-filter="sort" data-index="{{index}}"><text class="filter-dropdown-option-text">{{item}}</text></view></scroll-view></view>
    </view>
    <view class="lawyer-filter-actions">
      <view class="lawyer-filter-button primary" bindtap="onApply">Apply</view>
      <view class="lawyer-filter-button" bindtap="onReset">Reset</view>
    </view>
  </view>

  <view class="lawyer-list-body">
    <view class="lawyer-heading-accent"></view>
    <view class="lawyer-list-heading">Recently updated profiles</view>

    <view class="lawyer-list">
      <view class="lawyer-card" wx:for="{{items}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}" data-name="{{item.name}}">
        <view class="lawyer-profile">
          <image class="lawyer-photo" src="{{item.image}}" mode="aspectFill" wx:if="{{item.image}}" />
          <view class="lawyer-profile-detail">
            <view class="lawyer-name">{{item.name}}</view>
            <view class="lawyer-local-name" wx:if="{{item.nameLocal}}">{{item.nameLocal}}</view>
            <image class="lawyer-verified" wx:if="{{item.verified}}" src="https://www.legaloneglobal.com/images/Verilegal_logo_3_upper.png" mode="widthFix" />
            <view class="lawyer-positions" wx:if="{{item.positions.length}}">
              <text class="lawyer-position" wx:for="{{item.positions}}" wx:for-item="position" wx:key="*this">{{position}}</text>
            </view>
            <view class="lawyer-firm" wx:if="{{item.firm}}">{{item.firm}}</view>
            <view class="lawyer-location" wx:if="{{item.location}}">{{item.location}}</view>
            <view class="lawyer-contact" wx:for="{{item.contacts}}" wx:for-item="contact" wx:key="detail"><text>{{contact.type}}: </text>{{contact.detail}}</view>
          </view>
        </view>

        <view class="lawyer-metrics-title">LegalOne Merits</view>
        <view class="lawyer-metric-row metric-total">
          <text>Total deals/cases</text>
          <text class="metric-value" wx:if="{{item.numOfDeal}}">{{item.numOfDeal}}</text>
          <view class="metric-value metric-unavailable" wx:else><image src="https://www.legaloneglobal.com/images/hyphen.JPG" mode="aspectFit" /></view>
        </view>
        <view class="lawyer-metric-row">
          <view class="metric-label"><image class="merit-icon" src="https://www.legaloneglobal.com/images/LegalOne_Merits_Distinguished_Icon.png" mode="aspectFit" /><text>Distinguished</text></view>
          <text class="metric-value" wx:if="{{item.distinguished}}">{{item.distinguished}}</text>
          <view class="metric-value metric-unavailable" wx:else><image src="https://www.legaloneglobal.com/images/hyphen.JPG" mode="aspectFit" /></view>
        </view>
        <view class="lawyer-metric-row">
          <view class="metric-label"><image class="merit-icon" src="https://www.legaloneglobal.com/images/LegalOne_Merits_Exemplary_Icon.png" mode="aspectFit" /><text>Exemplary</text></view>
          <text class="metric-value" wx:if="{{item.exemplary}}">{{item.exemplary}}</text>
          <view class="metric-value metric-unavailable" wx:else><image src="https://www.legaloneglobal.com/images/hyphen.JPG" mode="aspectFit" /></view>
        </view>
        <view class="lawyer-metric-row">
          <view class="metric-label"><image class="merit-icon" src="https://www.legaloneglobal.com/images/LegalOne_Merits_Remarkable_Icon.png" mode="aspectFit" /><text>Remarkable</text></view>
          <text class="metric-value" wx:if="{{item.remarkable}}">{{item.remarkable}}</text>
          <view class="metric-value metric-unavailable" wx:else><image src="https://www.legaloneglobal.com/images/hyphen.JPG" mode="aspectFit" /></view>
        </view>
        <view class="lawyer-testimonials-title">LegalOne Testimonials</view>
        <view class="lawyer-metric-row testimonials-total">
          <text>No. of Testimonials</text>
          <text class="metric-value testimonial-value" wx:if="{{item.testimonials}}">{{item.testimonials}}</text>
          <view class="metric-value testimonial-value metric-unavailable" wx:else><image src="https://www.legaloneglobal.com/images/hyphen-blue.JPG" mode="aspectFit" /></view>
        </view>
      </view>

      <view class="lawyer-loading" wx:if="{{loading}}">Loading...</view>
      <view class="lawyer-list-end" wx:if="{{!loading && !hasMore && items.length}}">End of list</view>
      <view class="lawyer-list-end" wx:if="{{!loading && !items.length}}">No matching profiles</view>
    </view>
  </view>
</view>
<site-footer />
