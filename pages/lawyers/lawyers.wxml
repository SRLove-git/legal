<site-header />
<view class="subpage" style="padding-top:calc(88rpx + {{statusBarHeight}}px);">
  <view class="breadcrumb">
    <image class="breadcrumb-icon" src="/assets/img/court-icon.png" />
    <text class="breadcrumb-sep">&gt;</text>
    <text class="breadcrumb-text">Lawyers</text>
  </view>
  <view class="list-filters">SORT &amp; FILTER</view>
  <view class="list-body">
  <view class="list-heading"><view class="list-heading-dot"></view>Recently updated profiles</view>
  <view class="list-search-wrap">
    <input class="list-search-input" type="text" placeholder="Search lawyers" value="{{keyword}}" bindinput="onInput" bindconfirm="onSearch" confirm-type="search" />
  </view>
  <view class="list">
    <view class="lawyer-row" wx:for="{{items}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}" data-name="{{item.name}}">
      <image class="lawyer-row-photo" src="{{item.image}}" mode="aspectFill" wx:if="{{item.image}}" />
      <view class="lawyer-row-photo placeholder" wx:else></view>
      <view class="lawyer-row-detail">
        <view class="lawyer-row-name">{{item.name}}</view>
        <view class="lawyer-row-pos" wx:if="{{item.positions.length}}">{{item.positions[0]}}</view>
        <view class="lawyer-row-firm">{{item.firm}}</view>
        <view class="lawyer-row-loc">{{item.location}}</view>
      </view>
    </view>
    <view class="list-end" wx:if="{{!hasMore && items.length}}">No more results</view>
  </view>
  </view>
</view>
<site-footer />
