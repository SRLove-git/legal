.list {
  padding-bottom: 40rpx;
}

.list-hero {
  width: 100%;
}

.deal-filter-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 23rpx 28rpx;
  background: #edebeb;
  color: #2d2d2d;
  font-size: 30rpx;
  font-weight: 600;
}

.filter-count {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  box-sizing: border-box;
  background: #0084ba;
  color: #ffffff;
  font-size: 21rpx;
  line-height: 32rpx;
  text-align: center;
}

.filter-chevron,
.field-chevron {
  width: 13rpx;
  height: 13rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(45deg);
  transition: transform 0.2s ease;
}

.filter-chevron.open,
.field-chevron.open {
  transform: rotate(225deg);
}

.deal-filter-panel {
  padding: 28rpx 36rpx 34rpx;
  background: #f7f7f7;
  border-bottom: 2rpx solid #d6d6d6;
}

.deal-filter-picker,
.deal-filter-group {
  display: block;
  margin-bottom: 18rpx;
}

.deal-filter-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 2rpx solid #bcbcbc;
  background: #ffffff;
  color: #444444;
  font-size: 26rpx;
}

.deal-filter-field.active {
  border-color: #0084ba;
  color: #0084ba;
}

.deal-filter-options {
  max-height: 360rpx;
  border: 2rpx solid #d7d7d7;
  border-top: 0;
  background: #ffffff;
  box-sizing: border-box;
}

.deal-filter-option {
  display: flex;
  align-items: center;
  min-height: 68rpx;
  padding: 8rpx 20rpx;
  border-bottom: 1rpx solid #eeeeee;
  box-sizing: border-box;
  color: #444444;
  font-size: 25rpx;
}

.deal-filter-check {
  transform: scale(0.78);
  transform-origin: left center;
}

.deal-filter-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 26rpx;
}

.deal-filter-button {
  flex: 1;
  padding: 20rpx 12rpx;
  border: 2rpx solid #0084ba;
  border-radius: 44rpx;
  color: #0084ba;
  font-size: 27rpx;
  font-weight: 600;
  text-align: center;
}

.deal-filter-button.primary {
  background: #0084ba;
  color: #ffffff;
}

.deal-cover {
  display: block;
  width: 100vw;
  height: 420rpx;
  margin: -23rpx 0 25rpx -36rpx;
  background: #eef4f8;
}

.deal-merit {
  display: flex;
  align-items: center;
  gap: 9rpx;
  margin-bottom: 8rpx;
  color: #2d2d2d;
  font-size: 28rpx;
}

.deal-merit-logo {
  width: 27rpx;
  height: 36rpx;
  flex: 0 0 auto;
}

.deal-under-evaluation {
  color: #555555;
}
