<site-header />
<view class="subpage" style="padding-top:calc(88rpx + {{statusBarHeight}}px);">
  <view class="breadcrumb">
    <image class="breadcrumb-icon" src="/assets/img/court-icon.png" />
    <text class="breadcrumb-sep">></text>
    <text class="breadcrumb-text">Deals/Cases</text>
  </view>

  <view class="list-hero">
    <image class="list-hero-bg" src="/assets/img/homepage-banner.png" mode="aspectFill" />
    <view class="list-hero-inner">
      <view class="list-hero-title"><text class="list-hero-title-line">Showcasing Outstanding</text><text class="list-hero-title-line">Deals & Cases</text></view>
      <view class="list-hero-desc">Discover the LegalOne archive of corporate and commercial legal matters, a comprehensive collection of highly regarded transactions and cases submitted by lawyers and law firms, independently recognised with LegalOne Merits, a distinction that reflects excellence.</view>
      <view class="list-hero-actions">
        <view class="list-hero-btn">Submit deal/case</view>
      </view>
    </view>
  </view>

  <view class="list-filters">SORT & FILTER</view>

  <view class="list-body">
  <view class="list-heading"><view class="list-heading-dot"></view>Latest deals/cases</view>
  <view class="list-search-wrap">
    <input class="list-search-input" type="text" placeholder="Search deals and cases" value="{{keyword}}" bindinput="onInput" bindconfirm="onSearch" confirm-type="search" />
  </view>
  <view class="list">
    <view class="list-page-item" wx:for="{{items}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}" data-title="{{item.title}}">
      <text>{{item.title}}</text>
      <text class="list-page-meta">{{item.rank}} · {{item.date}}</text>
    </view>
    <view class="list-end" wx:if="{{!hasMore && items.length}}">No more results</view>
  </view>
  </view>
</view>
<site-footer />
