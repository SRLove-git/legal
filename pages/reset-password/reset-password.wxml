<site-header />
<view class="subpage" style="padding-top:calc(88rpx + {{statusBarHeight}}px);">
  <view class="breadcrumb">
    <image class="breadcrumb-icon" src="/assets/img/court-icon.png" />
    <text class="breadcrumb-sep">></text>
    <text class="breadcrumb-text">Reset password</text>
  </view>

  <view class="form">
    <view class="form-title">Reset password</view>
    <block wx:if="{{done}}">
      <view class="form-hint">Your password has been reset. You can now sign in with your new password.</view>
      <button class="form-btn" bindtap="backToLogin">Back to sign in</button>
    </block>
    <block wx:elif="{{linkOk}}">
      <view class="form-field"><input class="form-input" password="{{true}}" placeholder="New password" value="{{password}}" bindinput="onField" data-key="password" /></view>
      <view class="form-field"><input class="form-input" password="{{true}}" placeholder="Confirm new password" value="{{confirm}}" bindinput="onField" data-key="confirm" /></view>
      <view class="form-hint">Password must be at least 8 characters and include an uppercase letter, a lowercase letter and a digit.</view>
      <view class="form-error" wx:if="{{error}}">{{error}}</view>
      <button class="form-btn" bindtap="submit" loading="{{loading}}" disabled="{{loading}}">Reset password</button>
    </block>
    <block wx:else>
      <view class="form-error">{{error}}</view>
      <button class="form-btn" bindtap="backToLogin">Back to sign in</button>
    </block>
  </view>
</view>
<site-footer />
