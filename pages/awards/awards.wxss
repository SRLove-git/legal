@import "../../styles/filter-dropdown.wxss";

.list {
  padding-bottom: 40rpx;
}

/* Website "SORT & FILTER" bar (award_list). */
.award-filter-toggle {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 86rpx;
  padding: 18rpx 36rpx;
  background: #edebeb;
  color: #202020;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.4;
}

.filter-count {
  min-width: 34rpx;
  height: 34rpx;
  margin-left: 12rpx;
  padding: 0 8rpx;
  border-radius: 17rpx;
  background: #0084ba;
  color: #ffffff;
  font-size: 21rpx;
  line-height: 34rpx;
  text-align: center;
}

.filter-chevron,
.field-chevron {
  width: 0;
  height: 0;
  border-left: 9rpx solid transparent;
  border-right: 9rpx solid transparent;
  border-top: 12rpx solid #777777;
}

.filter-chevron {
  position: absolute;
  right: 82rpx;
  top: 38rpx;
  transition: transform 0.2s ease;
}

.filter-chevron.open {
  transform: rotate(180deg);
}

.award-filter-panel {
  padding: 28rpx 36rpx 34rpx;
  border-bottom: 2rpx solid #d9d9d9;
  background: #f6f6f6;
}

.award-filter-group {
  position: relative;
  margin-bottom: 18rpx;
}

.award-filter-field,
.award-search-field {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 76rpx;
  padding: 0 74rpx 0 24rpx;
  border: 2rpx solid #bcbcbc;
  background: #ffffff;
  color: #333333;
  font-size: 26rpx;
  line-height: 1.35;
}

.award-filter-field.active {
  border-color: #0084ba;
  color: #0084ba;
}

.field-chevron {
  position: absolute;
  right: 26rpx;
  top: 31rpx;
  transition: transform 0.2s ease;
}

.field-chevron.up {
  transform: rotate(180deg);
}

/* Both option lists are long, so they scroll inside the panel. */
.award-filter-options-frame {
  position: absolute;
  z-index: 50;
  top: 100%;
  right: 0;
  left: 0;
  margin-top: -2rpx;
  border: 2rpx solid #0084ba;
  border-radius: 0 0 8rpx 8rpx;
  background: #ffffff;
  box-sizing: border-box;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.2);
  overflow: hidden;
  transform-origin: top center;
  animation: filter-options-in 0.16s ease-out;
}

.award-filter-options {
  max-height: 520rpx;
  padding: 8rpx 24rpx;
  box-sizing: border-box;
}

.award-filter-option {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  color: #333333;
  font-size: 26rpx;
  line-height: 1.35;
}

.award-filter-check {
  margin-right: 14rpx;
  transform: scale(0.85);
}

.award-filter-option-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@keyframes filter-options-in {
  from { opacity: 0; transform: translateY(-8rpx) scaleY(0.96); }
  to { opacity: 1; transform: translateY(0) scaleY(1); }
}

.award-search-field {
  margin-bottom: 18rpx;
}

.award-search-field input {
  width: 100%;
  height: 72rpx;
  font-size: 26rpx;
}

.award-filter-actions {
  display: flex;
  gap: 18rpx;
  padding-top: 2rpx;
}

.award-filter-button {
  flex: 1;
  height: 72rpx;
  border: 2rpx solid #0084ba;
  color: #0084ba;
  font-size: 27rpx;
  line-height: 68rpx;
  text-align: center;
}

.award-filter-button.primary {
  background: #0084ba;
  color: #ffffff;
}
