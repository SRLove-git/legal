.ai-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #ffffff;
}

.ai-notice {
  padding: 100rpx 48rpx 80rpx;
}

.ai-notice-title {
  margin-bottom: 20rpx;
  color: #00558d;
  font-size: 40rpx;
  font-weight: 700;
}

.ai-notice-text {
  color: #555555;
  font-size: 27rpx;
  line-height: 1.6;
}

.ai-notice-url {
  margin-top: 28rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  background: #f7f7f7;
  color: #0084ba;
  font-size: 24rpx;
  word-break: break-all;
}

.ai-notice-button {
  height: 88rpx;
  margin-top: 44rpx;
  border-radius: 44rpx;
  background: #00558d;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 88rpx;
  text-align: center;
}

.ai-notice-button.ghost {
  margin-top: 32rpx;
  border: 2rpx solid #00558d;
  box-sizing: border-box;
  background: #ffffff;
  color: #00558d;
}
