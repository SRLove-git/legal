.ai-hero {
  padding: 70rpx 36rpx 50rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ai-logo {
  width: 300rpx;
  margin: 0 auto 60rpx;
}

.ai-search-bar {
  width: 100%;
  box-sizing: border-box;
  background: #ffffff;
  border: 2rpx solid #e8e8e8;
  border-radius: 999rpx;
  padding: 8rpx 10rpx 8rpx 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
}

.ai-beta {
  width: 100%;
  text-align: right;
  font-size: 22rpx;
  color: #9aa0a6;
  margin-top: 8rpx;
}

.ai-char-count {
  width: 100%;
  text-align: right;
  font-size: 20rpx;
  color: #8a96a3;
  margin-top: 12rpx;
}

.ai-disclaimer {
  width: 100%;
  margin-top: 26rpx;
  font-size: 21rpx;
  line-height: 30rpx;
  color: #777777;
}

.ai-input {
  width: 100%;
  height: 70rpx;
  font-size: 28rpx;
  color: #2d2d2d;
}

.ai-submit {
  margin-left: 16rpx;
  background: #f1ffb9;
  color: #00558d;
  font-weight: 700;
  font-size: 28rpx;
  border-radius: 42rpx;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 32rpx;
}

.prompts {
  margin-top: 26rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.prompt {
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  color: #ffffff;
  font-size: 24rpx;
  border-radius: 30rpx;
  padding: 10rpx 24rpx;
}

.results {
  padding: 20rpx 36rpx 40rpx;
}

.result-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eeeeee;
}

.result-type {
  font-size: 22rpx;
  color: #0084ba;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.result-title {
  font-size: 30rpx;
  color: #2d2d2d;
  font-weight: 600;
  line-height: 1.35;
}

.result-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #777777;
}
