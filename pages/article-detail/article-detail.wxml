<site-header />
<view class="subpage" wx:if="{{item}}" style="padding-top:calc(88rpx + {{statusBarHeight}}px);">
  <view class="breadcrumb">
    <image class="breadcrumb-icon" src="https://www.legaloneglobal.com/images/court-icon-4@2x.png" bindtap="goHome" />
    <text class="breadcrumb-sep">></text>
    <text class="breadcrumb-text" bindtap="goCrumb" data-url="{{crumbUrl}}">{{crumbLabel}}</text>
    <text class="breadcrumb-sep">></text>
    <text class="breadcrumb-current">{{item.title}}</text>
  </view>
  <view class="detail">
    <view class="detail-labels" wx:if="{{item.refNo || item.labels.length}}">
      <text class="detail-reference" wx:if="{{item.refNo}}">{{item.refNo}}</text>
      <text class="detail-label" wx:for="{{item.labels}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="detail-title">{{item.title}}</view>
    <view class="detail-meta">
      <text wx:if="{{item.author}}">By {{item.author}}</text>
      <text class="detail-meta-line detail-doi" wx:if="{{item.doi}}" bindtap="copyDoi">DOI: {{item.doiUrl}}</text>
      <text class="detail-meta-line" wx:if="{{item.publishedDate}}">Published: {{item.publishedDate}}</text>
      <text class="detail-meta-line" wx:if="{{item.updatedDate}}">Updated: {{item.updatedDate}}</text>
    </view>
    <image class="detail-image" src="{{item.image}}" mode="widthFix" wx:if="{{item.image}}" />
    <rich-text class="detail-rich" wx:if="{{item.bodyHtml}}" nodes="{{item.bodyHtml}}"></rich-text>
    <view class="detail-body" wx:elif="{{item.body}}">{{item.body}}</view>

    <view class="award" wx:if="{{item.award}}">
      <view class="award-title" wx:if="{{item.award.title}}"><text>{{item.award.title}}</text></view>
      <block wx:for="{{item.award.blocks}}" wx:key="id" wx:for-item="block" wx:for-index="blockIndex">
        <rich-text class="award-rich" wx:if="{{block.type === 'html' && block.html}}" nodes="{{block.html}}"></rich-text>
        <view class="award-winner" wx:elif="{{block.type === 'winner'}}">
          <view class="award-card">
            <image class="award-photo" wx:if="{{block.winner.photo}}" src="{{block.winner.photo}}" mode="widthFix" />
            <view class="award-info">
              <view class="award-winner-name">{{block.winner.name}}</view>
              <view class="award-winner-local" wx:if="{{block.winner.secondName}}">{{block.winner.secondName}}</view>
              <view class="award-winner-item" wx:if="{{block.winner.firm}}">{{block.winner.firm}}</view>
              <view class="award-winner-item" wx:if="{{block.winner.city}}">{{block.winner.city}}</view>
              <view class="award-winner-item" wx:for="{{block.winner.contacts}}" wx:for-item="line" wx:key="*this">{{line}}</view>
              <image
                class="award-view-profile"
                wx:if="{{block.winner.profileImg}}"
                src="{{block.winner.profileImg}}"
                mode="widthFix"
                bindtap="goWinner"
                data-kind="{{block.winner.profileKind}}"
                data-id="{{block.winner.profileId}}"
                data-name="{{block.winner.name}}"
              />
            </view>
          </view>
          <block wx:if="{{block.winner.hasBio}}">
            <view class="award-bio-label"><view class="award-bio-bar"></view><text>Biography</text></view>
            <rich-text class="award-bio {{block.winner.open ? 'open' : ''}}" nodes="{{block.winner.bioHtml}}"></rich-text>
            <view class="award-bio-toggle" wx:if="{{block.winner.bioLong}}" bindtap="toggleBio" data-index="{{blockIndex}}">{{block.winner.open ? 'Show less' : 'Continue reading'}}</view>
          </block>
        </view>
      </block>
    </view>

    <view class="detail-related-block" wx:if="{{related.length}}">
      <view class="detail-related-head">{{relatedHeading}}</view>
      <view class="detail-related" wx:for="{{related}}" wx:key="id" bindtap="goArticle" data-id="{{item.id}}" data-title="{{item.title}}">{{item.title}}</view>
    </view>
  </view>
</view>
<site-footer />
