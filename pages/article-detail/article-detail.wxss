.detail {
  padding: 30rpx 36rpx 60rpx;
}

.detail-labels {
  margin-bottom: 15rpx;
}

.detail-reference {
  display: inline-block;
  color: #303030;
  font-size: 24rpx;
  padding: 6rpx 12rpx 6rpx 0;
  margin-right: 12rpx;
}

.detail-label {
  display: inline-block;
  background: #f2f2f2;
  color: #555555;
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.detail-image {
  width: 100%;
  height: auto;
  background: #cccccc;
  margin: 31rpx 0;
}

.detail-title {
  font-size: 57rpx;
  font-weight: 700;
  color: #2d2d2d;
  line-height: 1.05;
  margin: 19rpx 0 15rpx;
}

.detail-meta {
  margin: 6rpx 0 38rpx;
  font-size: 22rpx;
  color: #2d2d2d;
}

.detail-meta-line {
  display: block;
  margin-top: 6rpx;
}

.detail-doi {
  color: #0084ba;
  word-break: break-all;
}

.detail-rich {
  display: block;
  color: #303030;
  font-size: 32rpx;
  line-height: 1.5;
  overflow: hidden;
}

.detail-body {
  font-size: 31rpx;
  color: #303030;
  line-height: 46rpx;
  white-space: pre-wrap;
}

.detail-related-block {
  margin-top: 56rpx;
}

.detail-related-head {
  font-size: 34rpx;
  font-weight: 700;
  color: #00558d;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #00558d;
  margin-bottom: 20rpx;
}

.detail-related {
  font-size: 28rpx;
  color: #0084ba;
  line-height: 1.45;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f1f1f1;
}
