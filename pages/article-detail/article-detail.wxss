.detail {
  padding: 30rpx 36rpx 60rpx;
}

.detail-labels {
  margin-bottom: 15rpx;
}

.detail-reference {
  display: inline-block;
  color: #303030;
  font-size: 24rpx;
  padding: 6rpx 12rpx 6rpx 0;
  margin-right: 12rpx;
}

.detail-label {
  display: inline-block;
  background: #f2f2f2;
  color: #555555;
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.detail-image {
  width: 100%;
  height: auto;
  background: #cccccc;
  margin: 31rpx 0;
}

.detail-title {
  font-size: 57rpx;
  font-weight: 700;
  color: #2d2d2d;
  line-height: 1.05;
  margin: 19rpx 0 15rpx;
}

.detail-meta {
  margin: 6rpx 0 38rpx;
  font-size: 22rpx;
  color: #2d2d2d;
}

.detail-meta-line {
  display: block;
  margin-top: 6rpx;
}

.detail-doi {
  color: #0084ba;
  word-break: break-all;
}

.detail-rich {
  display: block;
  color: #303030;
  font-size: 32rpx;
  line-height: 1.5;
  overflow: hidden;
}

.detail-body {
  font-size: 31rpx;
  color: #303030;
  line-height: 46rpx;
  white-space: pre-wrap;
}

.detail-related-block {
  margin-top: 56rpx;
}

.detail-related-head {
  font-size: 34rpx;
  font-weight: 700;
  color: #171717;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #00558d;
  margin-bottom: 20rpx;
}

.detail-related {
  font-size: 28rpx;
  color: #0084ba;
  line-height: 1.45;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f1f1f1;
}

/* Award write-ups: the website prints its "LIST OF WINNERS" block below the
   article body, with one artwork card per winner and a clamped biography. */
.award {
  margin-top: 50rpx;
}

.award-title {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 200rpx;
  margin: 82rpx 0;
  background: #000a5a;
}

.award-title text {
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 700;
  text-align: center;
}

/* Stellar Accolade uses the same practice-area accordion as the website: all
   rows start collapsed, with a small plus/minus control at the right edge. */
.award-region {
  margin-bottom: 20rpx;
}

.award-region-head {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 62rpx;
  padding: 30rpx 42rpx 30rpx 0;
  border-bottom: 1rpx solid #aaaaaa;
}

.award-region-head.open {
  border-bottom-color: transparent;
}

.award-region-head text {
  color: #171717;
  font-size: 49rpx;
  font-weight: 700;
  line-height: 1.24;
}

.award-region-sign {
  position: absolute;
  top: 50%;
  right: 10rpx;
  width: 22rpx;
  height: 22rpx;
  transform: translateY(-50%);
}

.award-region-content {
  overflow: hidden;
}

.award-featured {
  padding-top: 50rpx;
  background: #ececec;
}

.award-featured-title {
  margin-bottom: 24rpx;
  color: #000a5a;
  font-size: 53rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
}

.award-featured .award-bio-fade {
  background: linear-gradient(to bottom, rgba(236, 236, 236, 0.01) 9%, #ececec 91%);
}

.award-rich {
  display: block;
  color: #303030;
  font-size: 30rpx;
  line-height: 1.5;
  overflow: hidden;
}

.award-winner {
  margin-bottom: 46rpx;
}

.award-card {
  position: relative;
  /* The artwork is a fixed banner; keep any very long details inside it. */
  overflow: hidden;
}

.award-photo {
  display: block;
  width: 100%;
  /* Website: display:block; margin:0 auto; max-width:100%; the phone crop is
     396px wide, so never upscale it on a wide screen. */
  max-width: 792rpx;
  margin: 0 auto;
}

/* The winner details sit on the artwork's dark band, pushed a little below the
   middle so the card does not end with a large empty area underneath. */
.award-info {
  position: absolute;
  top: 58%;
  left: 62rpx;
  width: 85%;
  transform: translateY(-50%);
}

/* Tall Stellar Team artwork keeps the team photograph in its top 40%.
   Leave one normal text line between the photograph and the details. */
.award-card-tall .award-info {
  top: calc(40% + 42rpx);
  transform: none;
}

.award-winner-name {
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
  word-break: break-word;
}

.award-winner-local {
  margin-top: 4rpx;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.2;
}

.award-winner-item {
  display: block;
  margin: 8rpx 0;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 1.4;
  word-break: break-word;
}

.award-view-profile {
  width: 250rpx;
  height: auto;
  margin-top: 16rpx;
}

.award-bio-wrap {
  position: relative;
  margin-top: 20rpx;
}

.award-bio {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  max-height: 126rpx;
  padding: 0 36rpx;
  color: #303030;
  font-size: 29rpx;
  line-height: 42rpx;
}

.award-bio.open {
  display: block;
  max-height: none;
}

.award-bio-fade {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 100%;
  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.01) 9%, #ffffff 91%);
  pointer-events: none;
}

.award-bio-toggle {
  padding: 36rpx;
  color: #00558d;
  font-size: 30rpx;
  font-style: italic;
  text-decoration: underline;
  text-align: right;
}
