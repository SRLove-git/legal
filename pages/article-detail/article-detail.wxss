.detail {
  padding: 30rpx 36rpx 60rpx;
}

.labels {
  margin-bottom: 16rpx;
}

.label {
  display: inline-block;
  background: #f2f2f2;
  color: #555555;
  font-size: 21rpx;
  border-radius: 4rpx;
  padding: 6rpx 12rpx;
  margin-right: 16rpx;
  margin-bottom: 8rpx;
}

.detail-image {
  width: 100%;
  height: 360rpx;
  border-radius: 8rpx;
  background: #cccccc;
  margin: 18rpx 0;
}

.detail-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #00558d;
  line-height: 1.3;
}

.detail-meta {
  margin-top: 16rpx;
  font-size: 25rpx;
  color: #777777;
}

.detail-body {
  margin-top: 30rpx;
  font-size: 28rpx;
  color: #2d2d2d;
  line-height: 1.65;
}
