.detail {
  padding: 30rpx 36rpx 60rpx;
}

.detail-labels {
  margin-bottom: 15rpx;
}

.detail-reference {
  display: inline-block;
  color: #303030;
  font-size: 24rpx;
  padding: 6rpx 12rpx 6rpx 0;
  margin-right: 12rpx;
}

.detail-label {
  display: inline-block;
  background: #f2f2f2;
  color: #555555;
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.detail-image {
  width: 100%;
  height: auto;
  background: #cccccc;
  margin: 31rpx 0;
}

.detail-title {
  font-size: 57rpx;
  font-weight: 700;
  color: #2d2d2d;
  line-height: 1.05;
  margin: 19rpx 0 15rpx;
}

.detail-meta {
  margin: 6rpx 0 38rpx;
  font-size: 22rpx;
  color: #2d2d2d;
}

.detail-meta-line {
  display: block;
  margin-top: 6rpx;
}

.detail-doi {
  color: #0084ba;
  word-break: break-all;
}

.detail-rich {
  display: block;
  color: #303030;
  font-size: 32rpx;
  line-height: 1.5;
  overflow: hidden;
}

.detail-body {
  font-size: 31rpx;
  color: #303030;
  line-height: 46rpx;
  white-space: pre-wrap;
}

.detail-related-block {
  margin-top: 56rpx;
}

.detail-related-head {
  font-size: 34rpx;
  font-weight: 700;
  color: #00558d;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #00558d;
  margin-bottom: 20rpx;
}

.detail-related {
  font-size: 28rpx;
  color: #0084ba;
  line-height: 1.45;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f1f1f1;
}

/* Award write-ups: the website prints its "LIST OF WINNERS" block below the
   article body, with one artwork card per winner and a clamped biography. */
.award {
  margin-top: 50rpx;
}

.award-title {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 150rpx;
  margin: 60rpx -36rpx;
  background: #000a5a;
}

.award-title text {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
}

.award-rich {
  display: block;
  color: #303030;
  font-size: 30rpx;
  line-height: 1.5;
  overflow: hidden;
}

.award-winner {
  margin-bottom: 46rpx;
}

.award-card {
  position: relative;
  /* The artwork is a fixed banner; keep any very long details inside it. */
  overflow: hidden;
}

.award-photo {
  display: block;
  width: 100%;
  /* Website: display:block; margin:0 auto; max-width:100%; the phone crop is
     396px wide, so never upscale it on a wide screen. */
  max-width: 792rpx;
  margin: 0 auto;
}

/* The winner details sit on the artwork's dark band, pushed a little below the
   middle so the card does not end with a large empty area underneath. */
.award-info {
  position: absolute;
  top: 58%;
  left: 34rpx;
  width: 85%;
  transform: translateY(-50%);
}

.award-winner-name {
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
  word-break: break-word;
}

.award-winner-local {
  margin-top: 4rpx;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.2;
}

.award-winner-item {
  display: block;
  margin: 8rpx 0;
  color: #ffffff;
  font-size: 27rpx;
  line-height: 1.4;
  word-break: break-word;
}

.award-view-profile {
  width: 250rpx;
  height: auto;
  margin-top: 16rpx;
}

.award-bio-label {
  display: flex;
  align-items: center;
  margin: 26rpx 0 12rpx;
}

.award-bio-bar {
  width: 8rpx;
  height: 34rpx;
  margin-right: 16rpx;
  background: #2f80ed;
}

.award-bio-label text {
  color: #000000;
  font-size: 32rpx;
  font-weight: 600;
}

.award-bio {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 6;
  overflow: hidden;
  max-height: 300rpx;
  color: #303030;
  font-size: 29rpx;
  line-height: 1.5;
}

.award-bio.open {
  display: block;
  max-height: none;
}

.award-bio-toggle {
  margin-top: 10rpx;
  color: #00558d;
  font-size: 26rpx;
  font-style: italic;
  text-decoration: underline;
  text-align: right;
}
