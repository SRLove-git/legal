@import "../register/register.wxss";

.sector-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 24rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #2d2d2d;
  background: #ffffff;
}

.sector-item.on {
  border-color: #0084ba;
  color: #00558d;
  font-weight: 600;
}

.sector-mark {
  color: #0084ba;
}
