<site-header />
<view class="subpage" style="padding-top:calc(88rpx + {{statusBarHeight}}px);">
  <view class="breadcrumb">
    <image class="breadcrumb-icon" src="/assets/img/court-icon.png" />
    <text class="breadcrumb-sep">></text>
    <text class="breadcrumb-text">Forgot password</text>
  </view>

  <view class="form">
    <view class="form-title">Forgot password</view>
    <block wx:if="{{done}}">
      <view class="form-hint">If an account exists for {{email}}, we have sent a password recovery email. Open the link in that email to reset your password.</view>
      <button class="form-btn" bindtap="backToLogin">Back to sign in</button>
    </block>
    <block wx:else>
      <view class="form-hint">Enter the email address on your LegalOne account and we will send a recovery link.</view>
      <view class="form-field"><input class="form-input" type="text" placeholder="Email address" value="{{email}}" bindinput="onEmail" /></view>
      <view class="form-hint" wx:if="{{!captchaReady}}">Captcha is not configured yet — configure it in config.js before going live.</view>
      <view class="form-error" wx:if="{{error}}">{{error}}</view>
      <button class="form-btn" bindtap="submit" loading="{{loading}}" disabled="{{loading}}">Send recovery email</button>
    </block>
  </view>
</view>
<site-footer />
