.dci-page {
  padding-top: calc(88rpx + 54px);
}

.breadcrumb {
  padding: 28rpx 36rpx;
  font-size: 26rpx;
  color: #555;
  border-bottom: 1rpx solid #eee;
}

.dci-section {
  padding: 48rpx 0;
}

.dci-section-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #00558d;
  margin-bottom: 32rpx;
}

.dci-cards {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.dci-card {
  width: 100%;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 28rpx;
}

.dci-card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0084ba;
  margin-bottom: 12rpx;
}

.dci-card-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #2d2d2d;
}

.dci-merits {
  margin-top: 32rpx;
  background: #00558d;
  color: #fff;
  border-radius: 12rpx;
  padding: 32rpx;
}

.dci-merits-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.dci-merits-text {
  font-size: 28rpx;
  line-height: 1.6;
}

.dci-doty {
  background: #f2f2f2;
}

.dci-feature-card {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.dci-feature-img {
  width: 100%;
  height: 320rpx;
}

.dci-feature-title {
  padding: 24rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #00558d;
}

.dci-faq-group {
  border-bottom: 1rpx solid #eee;
}

.dci-faq-group-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  font-size: 32rpx;
  font-weight: 700;
  color: #00558d;
}

.dci-faq-toggle {
  font-size: 40rpx;
  color: #0084ba;
}

.dci-faq-item {
  padding: 8rpx 0 28rpx;
}

.dci-faq-q {
  font-size: 28rpx;
  font-weight: 700;
  color: #2d2d2d;
  margin-bottom: 10rpx;
}

.dci-faq-a {
  font-size: 27rpx;
  line-height: 1.6;
  color: #555;
}
