<site-header />
<view class="subpage">
  <view class="breadcrumb"> &gt; Law Firms</view>
  <view class="subpage-title">Law Firms</view>
  <view class="list-search-wrap">
    <input class="list-search-input" type="text" placeholder="Search law firms" value="{{keyword}}" bindinput="onInput" bindconfirm="onSearch" confirm-type="search" />
  </view>
  <view class="list">
    <view class="firm-row" wx:for="{{items}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}" data-name="{{item.name}}">
      <image class="firm-row-logo" src="{{item.image}}" mode="aspectFit" />
      <view class="firm-row-name">{{item.name}}</view>
    </view>
    <view class="list-end" wx:if="{{!hasMore && items.length}}">No more results</view>
  </view>
</view>
<site-footer />
