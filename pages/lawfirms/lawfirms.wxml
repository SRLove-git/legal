<site-header />
<view class="subpage" style="padding-top:calc(88rpx + {{statusBarHeight}}px);">
  <view class="breadcrumb">
    <image class="breadcrumb-icon" src="/assets/img/court-icon.png" bindtap="goHome" />
    <text class="breadcrumb-sep">></text>
    <text class="breadcrumb-text">Law Firms</text>
  </view>
  <view class="list-filters">SORT & FILTER</view>
  <view class="list-body">
  <view class="list-heading"><view class="list-heading-dot"></view>Recently updated profiles</view>
  <view class="list-search-wrap">
    <input class="list-search-input" type="text" placeholder="Search law firms" value="{{keyword}}" bindinput="onInput" bindconfirm="onSearch" confirm-type="search" />
  </view>
  <view class="list">
    <view class="firm-row" wx:for="{{items}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}" data-name="{{item.name}}">
      <image class="firm-row-logo" src="{{item.image}}" mode="aspectFit" />
      <view class="firm-row-name">{{item.name}}</view>
    </view>
    <view class="list-end" wx:if="{{!hasMore && items.length}}">No more results</view>
  </view>
  </view>
</view>
<site-footer />
