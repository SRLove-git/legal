<site-header />
<view class="subpage lawfirms-page" style="padding-top:calc(88rpx + {{statusBarHeight}}px);" bindtap="closeDropdowns">
  <view class="breadcrumb">
    <image class="breadcrumb-icon" src="https://www.legaloneglobal.com/images/court-icon-4@2x.png" bindtap="goHome" />
    <text class="breadcrumb-sep">></text>
    <text class="breadcrumb-text">Law Firms</text>
  </view>

  <view class="firm-filter-toggle" bindtap="toggleFilters">
    <text>{{sortFilterLabel}}</text>
    <text class="filter-count" wx:if="{{activeFilterCount}}">{{activeFilterCount}}</text>
    <view class="filter-chevron {{filtersOpen ? 'open' : ''}}"></view>
  </view>

  <view class="firm-filter-panel" wx:if="{{filtersOpen}}">
    <view class="firm-filter-picker filter-dropdown-group">
      <view class="firm-filter-field filter-dropdown-field {{countryIndex ? 'active is-active' : ''}} {{openSelect === 'country' ? 'is-open' : ''}}" catchtap="toggleSelect" data-filter="country"><text class="filter-dropdown-field-label">{{countryOptions[countryIndex]}}</text><view class="filter-dropdown-chevron {{openSelect === 'country' ? 'is-open' : ''}}"></view></view>
      <view class="filter-dropdown-popup" wx:if="{{openSelect === 'country'}}"><scroll-view class="filter-dropdown-scroll" scroll-y="true" enhanced="true" show-scrollbar="false" style="height: {{countryOptions.length > 5 ? 360 : countryOptions.length * 68}}rpx;"><view class="filter-dropdown-option {{index === countryIndex ? 'is-selected' : ''}}" wx:for="{{countryOptions}}" wx:key="*this" catchtap="onSelectOption" data-filter="country" data-index="{{index}}"><text class="filter-dropdown-option-text">{{item}}</text></view></scroll-view></view>
    </view>

    <view class="firm-filter-group filter-dropdown-group">
      <view class="firm-filter-field filter-dropdown-field {{offices.length ? 'active is-active' : ''}} {{openGroups.offices ? 'is-open' : ''}}" catchtap="toggleGroup" data-group="offices">
        <text class="filter-dropdown-field-label">{{officesLabel}}</text>
        <view class="filter-dropdown-chevron {{openGroups.offices ? 'is-open' : ''}}"></view>
      </view>
      <view class="firm-filter-options-frame filter-dropdown-popup" wx:if="{{openGroups.offices}}">
        <scroll-view class="firm-filter-options filter-dropdown-scroll" scroll-y="true" enhanced="true" show-scrollbar="false" style="height: {{officeOptions.length > 5 ? 360 : officeOptions.length * 68}}rpx;">
          <view class="firm-filter-option filter-dropdown-option {{option.checked ? 'is-selected' : ''}}" wx:for="{{officeOptions}}" wx:for-item="option" wx:key="value" catchtap="toggleMultiOption" data-group="offices" data-value="{{option.value}}">
            <text class="firm-filter-option-text filter-dropdown-option-text">{{option.value}}</text>
          </view>
        </scroll-view>
      </view>
    </view>

    <view class="firm-filter-group filter-dropdown-group">
      <view class="firm-filter-field filter-dropdown-field {{areas.length ? 'active is-active' : ''}} {{openGroups.areas ? 'is-open' : ''}}" catchtap="toggleGroup" data-group="areas">
        <text class="filter-dropdown-field-label">{{areasLabel}}</text>
        <view class="filter-dropdown-chevron {{openGroups.areas ? 'is-open' : ''}}"></view>
      </view>
      <view class="firm-filter-options-frame filter-dropdown-popup" wx:if="{{openGroups.areas}}">
        <scroll-view class="firm-filter-options filter-dropdown-scroll" scroll-y="true" enhanced="true" show-scrollbar="false" style="height: {{areaOptions.length > 5 ? 360 : areaOptions.length * 68}}rpx;">
          <view class="firm-filter-option filter-dropdown-option {{option.checked ? 'is-selected' : ''}}" wx:for="{{areaOptions}}" wx:for-item="option" wx:key="value" catchtap="toggleMultiOption" data-group="areas" data-value="{{option.value}}">
            <text class="firm-filter-option-text filter-dropdown-option-text">{{option.value}}</text>
          </view>
        </scroll-view>
      </view>
    </view>

    <view class="firm-search-field">
      <input placeholder="Search by name / keyword" value="{{keyword}}" bindinput="onInput" bindconfirm="onApply" confirm-type="search" />
      <view class="search-icon" bindtap="onApply"></view>
    </view>

    <view class="firm-filter-picker filter-dropdown-group">
      <view class="firm-filter-field filter-dropdown-field {{sortIndex ? 'active is-active' : ''}} {{openSelect === 'sort' ? 'is-open' : ''}}" catchtap="toggleSelect" data-filter="sort"><text class="filter-dropdown-field-label">{{sortOptions[sortIndex]}}</text><view class="filter-dropdown-chevron {{openSelect === 'sort' ? 'is-open' : ''}}"></view></view>
      <view class="filter-dropdown-popup" wx:if="{{openSelect === 'sort'}}"><scroll-view class="filter-dropdown-scroll" scroll-y="true" enhanced="true" show-scrollbar="false" style="height: {{sortOptions.length > 5 ? 360 : sortOptions.length * 68}}rpx;"><view class="filter-dropdown-option {{index === sortIndex ? 'is-selected' : ''}}" wx:for="{{sortOptions}}" wx:key="*this" catchtap="onSelectOption" data-filter="sort" data-index="{{index}}"><text class="filter-dropdown-option-text">{{item}}</text></view></scroll-view></view>
    </view>

    <view class="firm-filter-actions">
      <view class="firm-filter-button primary" bindtap="onApply">Apply</view>
      <view class="firm-filter-button" bindtap="onReset">Reset</view>
    </view>
  </view>

  <view class="list-body">
    <view class="list-heading"><view class="list-heading-dot"></view>Recently updated profiles</view>
    <view class="list">
      <view class="firm-row" wx:for="{{items}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}" data-name="{{item.name}}">
        <view class="firm-row-logo-box">
          <image class="firm-row-logo" src="{{item.image}}" mode="aspectFit" />
        </view>
        <view class="firm-row-name">{{item.name}}</view>
        <view class="firm-row-local-name" wx:if="{{item.nameLocal}}">{{item.nameLocal}}</view>

        <!-- The website prints the head office's city/country under the name. -->
        <view class="firm-row-location" wx:if="{{item.headOffice && item.headOffice.location}}">{{item.headOffice.location}}</view>

        <view class="firm-merits-title">LegalOne Merits</view>
        <view class="firm-merit-row merit-total">
          <text>Total deals/cases</text>
          <text class="firm-merit-value" wx:if="{{item.numOfDeal}}">{{item.numOfDeal}}</text>
          <view class="firm-merit-value merit-unavailable" wx:else><image src="https://www.legaloneglobal.com/images/hyphen.JPG" mode="aspectFit" /></view>
        </view>
        <view class="firm-merit-row">
          <view class="firm-merit-label"><image class="firm-merit-icon" src="https://www.legaloneglobal.com/images/LegalOne_Merits_Distinguished_Icon.png" mode="aspectFit" /><text>Distinguished</text></view>
          <text class="firm-merit-value" wx:if="{{item.distinguished}}">{{item.distinguished}}</text>
          <view class="firm-merit-value merit-unavailable" wx:else><image src="https://www.legaloneglobal.com/images/hyphen.JPG" mode="aspectFit" /></view>
        </view>
        <view class="firm-merit-row">
          <view class="firm-merit-label"><image class="firm-merit-icon" src="https://www.legaloneglobal.com/images/LegalOne_Merits_Exemplary_Icon.png" mode="aspectFit" /><text>Exemplary</text></view>
          <text class="firm-merit-value" wx:if="{{item.exemplary}}">{{item.exemplary}}</text>
          <view class="firm-merit-value merit-unavailable" wx:else><image src="https://www.legaloneglobal.com/images/hyphen.JPG" mode="aspectFit" /></view>
        </view>
        <view class="firm-merit-row">
          <view class="firm-merit-label"><image class="firm-merit-icon" src="https://www.legaloneglobal.com/images/LegalOne_Merits_Remarkable_Icon.png" mode="aspectFit" /><text>Remarkable</text></view>
          <text class="firm-merit-value" wx:if="{{item.remarkable}}">{{item.remarkable}}</text>
          <view class="firm-merit-value merit-unavailable" wx:else><image src="https://www.legaloneglobal.com/images/hyphen.JPG" mode="aspectFit" /></view>
        </view>
      </view>
      <view class="list-end" wx:if="{{!items.length && !loading}}">No law firms found</view>
      <view class="list-end" wx:elif="{{!hasMore && !loading}}">No more results</view>
    </view>
  </view>
</view>
<site-footer />
