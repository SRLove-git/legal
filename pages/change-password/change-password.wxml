<site-header />
<view class="subpage" style="padding-top:calc(88rpx + {{statusBarHeight}}px);">
  <view class="breadcrumb">
    <image class="breadcrumb-icon" src="/assets/img/court-icon.png" bindtap="goHome" />
    <text class="breadcrumb-sep">></text>
    <text class="breadcrumb-text" bindtap="goCrumb" data-url="/pages/account/account">Account</text>
  </view>
  <view class="form">
    <view class="form-title">Change password</view>
    <block wx:if="{{done}}">
      <view class="form-hint">Your password has been updated.</view>
      <button class="form-btn" bindtap="back">Back</button>
    </block>
    <block wx:else>
      <view class="form-field"><input class="form-input" password="{{true}}" placeholder="Current password" value="{{original}}" bindinput="onField" data-key="original" /></view>
      <view class="form-field"><input class="form-input" password="{{true}}" placeholder="New password" value="{{next}}" bindinput="onField" data-key="next" /></view>
      <view class="form-field"><input class="form-input" password="{{true}}" placeholder="Confirm new password" value="{{confirm}}" bindinput="onField" data-key="confirm" /></view>
      <view class="form-hint">Password must be at least 8 characters and include an uppercase letter, a lowercase letter and a digit.</view>
      <view class="form-error" wx:if="{{error}}">{{error}}</view>
      <button class="form-btn" bindtap="submit" loading="{{loading}}" disabled="{{loading}}">Submit</button>
    </block>
  </view>
</view>
<site-footer />
