<site-header />
<view class="subpage" style="padding-top:calc(88rpx + {{statusBarHeight}}px);">
  <view class="breadcrumb"> &gt; Highlights</view>
  <view class="subpage-title">Highlights</view>
  <view class="list-search-wrap">
    <input class="list-search-input" type="text" placeholder="Search highlights" value="{{keyword}}" bindinput="onInput" bindconfirm="onSearch" confirm-type="search" />
  </view>
  <view class="list">
    <view class="list-page-item" wx:for="{{items}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}" data-title="{{item.title}}">
      <text>{{item.title}}</text>
      <text class="list-page-meta">{{item.author}} · {{item.date}}</text>
    </view>
    <view class="list-end" wx:if="{{!hasMore && items.length}}">No more results</view>
  </view>
</view>
<site-footer />
