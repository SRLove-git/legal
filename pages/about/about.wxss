.about-hero {
  position: relative;
  overflow: hidden;
  background: #00558d;
  padding: 69rpx 36rpx 77rpx;
  box-sizing: border-box;
  color: #ffffff;
}

.about-hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.about-hero-inner {
  position: relative;
  z-index: 2;
}

.about-hero-title {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 58rpx;
  margin-bottom: 27rpx;
}

.about-hero-subtitle {
  font-size: 38rpx;
  color: #ffffff;
}

.about-hero-cta {
  margin-top: 44rpx;
  display: inline-block;
  background: #ffffff;
  color: #00558d;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  padding: 16rpx 40rpx;
}

.about-block {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eeeeee;
}

.subpage .subpage-section-heading {
  font-size: 69rpx;
  line-height: 1.2;
  color: #0284c7;
  margin-top: 60rpx;
  margin-bottom: 30rpx;
}

.about-block-title {
  font-size: 31rpx;
  font-weight: 700;
  color: #303030;
  margin-bottom: 18rpx;
}

.about-block-desc {
  font-size: 27rpx;
  color: #555555;
  line-height: 1.5;
}

/* Matches the website's .about-explore-btn pill */
.about-explore {
  display: inline-block;
  margin-top: 20rpx;
  padding: 17rpx 42rpx;
  border: 1rpx solid #000000;
  border-radius: 42rpx;
  background: #ffffff;
  color: #000000;
  font-size: 28rpx;
  line-height: 1.3;
}

.about-explore-hover {
  opacity: 0.7;
}

.about-bullet {
  padding: 12rpx 0;
  font-size: 27rpx;
  color: #2d2d2d;
  line-height: 1.45;
  border-bottom: 1rpx solid #f1f1f1;
}

.contact {
  background: #f7f7f7;
}

.contact-row {
  font-size: 27rpx;
  color: #2d2d2d;
  line-height: 1.6;
  padding: 6rpx 0;
}
