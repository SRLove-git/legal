<site-header />
<view class="subpage" style="padding-top:calc(88rpx + {{statusBarHeight}}px);">
  <view class="breadcrumb">
    <image class="breadcrumb-icon" src="https://www.legaloneglobal.com/images/court-icon-4@2x.png" bindtap="goHome" />
    <text class="breadcrumb-sep">></text>
    <text class="breadcrumb-text">About</text>
  </view>

  <view class="about-hero">
    <image class="about-hero-bg" src="https://www.legaloneglobal.com/images/Homepage/HomepageBanner.png" mode="aspectFill" />
    <view class="about-hero-inner">
      <view class="about-hero-title">{{hero.title}}</view>
      <view class="about-hero-subtitle">{{hero.subtitle}}</view>
      <view class="about-hero-brochures">
        <image class="about-hero-brochure-cover" src="https://www.legaloneglobal.com/images/AboutUs/hero/legalone-corporate-brochure-cover.png" mode="aspectFill" />
        <view class="about-hero-brochure-label">{{hero.brochureLabel}}</view>
        <view class="about-hero-brochure-links">
          <block wx:for="{{hero.brochures}}" wx:key="label">
            <text class="about-hero-brochure-sep" wx:if="{{index > 0}}">|</text>
            <text class="about-hero-brochure-link" bindtap="openBrochure" data-url="{{item.url}}">{{item.label}}</text>
          </block>
        </view>
      </view>
    </view>
  </view>

  <view class="subpage-section">
    <view class="subpage-section-heading">About LegalOne</view>
    <view class="subpage-section-text">{{intro}}</view>
  </view>

  <view class="subpage-section">
    <view class="subpage-section-heading">Awards & Recognitions</view>
    <view class="about-awards-list">
      <view class="about-award-card" wx:for="{{awards}}" wx:key="image">
        <view class="about-award-logo-wrap">
          <image class="about-award-logo" src="{{item.image}}" mode="aspectFit" />
        </view>
        <view class="about-block-title">{{item.title}}</view>
        <view class="about-block-desc">{{item.desc}}</view>
        <view class="about-explore" hover-class="about-explore-hover" wx:if="{{item.link}}" bindtap="onExplore" data-link="{{item.link}}" data-title="{{item.title}}">Explore more</view>
      </view>
    </view>
  </view>

  <view class="subpage-section">
    <view class="subpage-section-heading">Standards & Identifiers</view>
    <view class="about-block" wx:for="{{standards}}" wx:key="title">
      <view class="about-card-logo-wrap">
        <image class="about-card-logo" src="{{item.image}}" mode="aspectFit" lazy-load="true" />
      </view>
      <view class="about-block-title">{{item.title}}</view>
      <view class="about-block-desc">{{item.desc}}</view>
      <view class="about-explore" hover-class="about-explore-hover" wx:if="{{item.link}}" bindtap="onExplore" data-link="{{item.link}}" data-title="{{item.title}}">Explore more</view>
    </view>
  </view>

  <view class="subpage-section">
    <view class="subpage-section-heading">Signatories</view>
    <view class="about-block" wx:for="{{signatories}}" wx:key="title">
      <view class="about-card-logo-wrap">
        <image class="about-card-logo" src="{{item.image}}" mode="aspectFit" lazy-load="true" />
      </view>
      <view class="about-block-title">{{item.title}}</view>
      <view class="about-block-desc">{{item.desc}}</view>
      <view class="about-explore" hover-class="about-explore-hover" wx:if="{{item.link}}" bindtap="onExplore" data-link="{{item.link}}" data-title="{{item.title}}">Explore more</view>
    </view>
  </view>

  <view class="subpage-section">
    <view class="subpage-section-heading">Advisory Appointments & Memberships</view>
    <view class="about-block" wx:for="{{memberships}}" wx:key="title">
      <view class="about-card-logo-wrap {{membershipImages[index].image2 ? 'about-card-logo-wrap-multi' : ''}}">
        <image class="about-card-logo {{membershipImages[index].image2 ? 'about-card-logo-half' : ''}}" src="{{membershipImages[index].image}}" mode="aspectFit" lazy-load="true" />
        <image class="about-card-logo about-card-logo-half" wx:if="{{membershipImages[index].image2}}" src="{{membershipImages[index].image2}}" mode="aspectFit" lazy-load="true" />
      </view>
      <view class="about-block-title">{{item.title}}</view>
      <view class="about-block-desc">{{item.desc}}</view>
      <view class="about-explore" hover-class="about-explore-hover" wx:if="{{item.link}}" bindtap="onExplore" data-link="{{item.link}}" data-title="{{item.title}}">Explore more</view>
    </view>
  </view>

  <view class="subpage-section">
    <view class="subpage-section-heading">ESG Commitments</view>
    <view class="about-block" wx:for="{{esg}}" wx:key="title">
      <view class="about-card-logo-wrap">
        <image class="about-card-logo" src="{{esgImages[index]}}" mode="aspectFit" lazy-load="true" />
      </view>
      <view class="about-block-title">{{item.title}}</view>
      <view class="about-explore" hover-class="about-explore-hover" wx:if="{{item.link}}" bindtap="onExplore" data-link="{{item.link}}" data-title="{{item.title}}">Explore more</view>
    </view>
  </view>

  <view class="subpage-section">
    <view class="subpage-section-heading">Official Partnerships & Strategic Affiliations</view>
    <view class="about-block" wx:for="{{partnerships}}" wx:key="title">
      <view class="about-card-logo-wrap">
        <image class="about-card-logo" src="{{item.image}}" mode="aspectFit" lazy-load="true" />
      </view>
      <view class="about-block-title">{{item.title}}</view>
      <view class="about-bullet" wx:for="{{item.items}}" wx:for-item="it" wx:key="*this">{{it}}</view>
      <view class="about-explore" hover-class="about-explore-hover" wx:if="{{item.link}}" bindtap="onExplore" data-link="{{item.link}}" data-title="{{item.title}}">Explore more</view>
    </view>
  </view>

  <view class="subpage-section">
    <view class="subpage-section-heading">LegalOne Deals of the Year in Libraries Worldwide</view>
    <view class="subpage-section-text">{{libraries}}</view>
    <image class="about-library-map" src="{{libraryMap}}" mode="widthFix" lazy-load="true" bindtap="previewLibraryMap" />
    <scroll-view class="about-library-logos" scroll-x="true" enhanced="true" show-scrollbar="{{false}}">
      <view class="about-library-logos-row">
        <view class="about-library-logo-item" wx:for="{{libraryLogos}}" wx:key="*this">
          <image class="about-library-logo" src="{{item}}" mode="aspectFit" lazy-load="true" />
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="subpage-section contact">
    <view class="subpage-section-heading">Contact Us</view>
    <view class="contact-row">Address: {{contact.address}}</view>
    <view class="contact-row">Phone / Whatsapp: {{contact.phone}}</view>
    <view class="contact-row">General and sales: {{contact.general}}</view>
    <view class="contact-row">Editorial and research: {{contact.editorial}}</view>
    <view class="contact-row">LinkedIn: {{contact.linkedin}}</view>
    <view class="contact-row">WeChat Account: {{contact.wechat}}</view>
  </view>
</view>
<site-footer />
