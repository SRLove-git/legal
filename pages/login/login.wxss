.login {
  padding: 40rpx 36rpx 80rpx;
}

.login-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #00558d;
  margin-bottom: 30rpx;
}

.field {
  margin-bottom: 22rpx;
}

.field-input {
  height: 88rpx;
  border: 2rpx solid #dddddd;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 29rpx;
  background: #ffffff;
}

.login-error {
  color: #c0392b;
  font-size: 25rpx;
  line-height: 1.4;
  margin-bottom: 22rpx;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #0084ba;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
}

.login-btn[disabled] {
  opacity: 0.7;
  color: #ffffff;
}
