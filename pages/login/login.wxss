.login {
  padding: 40rpx 36rpx 80rpx;
}

.login-logo {
  width: 260rpx;
  margin: 20rpx auto 40rpx;
}

.login-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #00558d;
  margin-bottom: 30rpx;
}

.field {
  margin-bottom: 22rpx;
}

.field-input {
  height: 88rpx;
  border: 2rpx solid #dddddd;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 29rpx;
  background: #ffffff;
}

.login-error {
  color: #c0392b;
  font-size: 25rpx;
  line-height: 1.4;
  margin-bottom: 22rpx;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #0084ba;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
}

.login-btn[disabled] {
  opacity: 0.7;
  color: #ffffff;
}

.login-links {
  margin-top: 26rpx;
  text-align: center;
  font-size: 25rpx;
  color: #555555;
}

.login-link {
  color: #0084ba;
}

.login-link-sep {
  margin: 0 12rpx;
  color: #999999;
}

.login-agreement {
  margin-top: 40rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #999999;
}
