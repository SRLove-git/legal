.lawfirm-office-page {
  background: #ffffff;
}

.office-detail {
  padding: 20rpx 26rpx 80rpx;
  color: #2d2d2d;
}

.office-ref {
  padding: 10rpx 0 20rpx;
  font-size: 25rpx;
  line-height: 1.4;
}

.office-name-block {
  margin-bottom: 12rpx;
}

.office-name {
  color: #171717;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.25;
  word-break: break-word;
}

.office-location {
  margin-top: 8rpx;
  color: #0084ba;
  font-size: 26rpx;
  line-height: 1.35;
}

.office-updated {
  margin-bottom: 16rpx;
  font-size: 25rpx;
  font-style: italic;
  line-height: 1.4;
}

.office-action-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 40rpx;
  width: 100%;
  padding: 8rpx 0 16rpx;
}

.office-share-button,
.office-save-button {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0;
  padding: 0;
  min-height: 42rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #636363;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 42rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.office-share-button::after {
  border: 0;
}

.office-share-icon {
  width: 42rpx;
  height: 34rpx;
  overflow: hidden;
}

.office-share-sprite {
  display: block;
  width: 42rpx;
  height: auto;
}

.office-save-icon {
  display: block;
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 42rpx;
}

.office-save-button.is-saved {
  color: #00558d;
}

.office-save-button.is-loading {
  opacity: 0.55;
}

/* LegalOne Merits table (website .lawfirm-meritTableProfile). */
.office-merit-card {
  position: relative;
  margin: 70rpx auto 40rpx;
  padding: 30rpx 20rpx 20rpx;
  border: 4rpx solid #00558d;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.office-merit-label {
  position: absolute;
  left: 50%;
  top: -30rpx;
  width: 400rpx;
  box-sizing: border-box;
  padding: 14rpx 20rpx;
  border: 2rpx solid #99cee3;
  border-radius: 20rpx;
  background: #00558d;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
  transform: translateX(-50%);
}

.office-merit-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
  margin: 12rpx 0;
}

.office-merit-row.total {
  margin-top: 30rpx;
  font-weight: 700;
}

.office-merit-name {
  display: flex;
  align-items: center;
}

.merit-icon {
  width: 44rpx;
  height: 60rpx;
  margin-right: 10rpx;
}

.office-merit-value {
  min-width: 90rpx;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  background: #00558d;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
  box-sizing: border-box;
}

.office-merit-value.unavailable {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 90rpx;
  height: 52rpx;
  padding: 0;
  overflow: hidden;
}

.office-merit-value.unavailable image {
  display: block;
  width: 10rpx;
  height: 4rpx;
}

/* "This is an office profile..." back link, as on the website. */
.office-firm-link {
  margin: 30rpx 0 0;
  padding: 22rpx 24rpx;
  border-left: 6rpx solid #0084ba;
  background: #f4f9fc;
  color: #0084ba;
  font-size: 26rpx;
  line-height: 1.45;
}

.office-band {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 80rpx;
  margin: 74rpx 0;
  background: #00558d;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 0.2em;
}

.office-section {
  margin-top: 64rpx;
}

.office-section-title {
  margin-bottom: 18rpx;
  padding-bottom: 10rpx;
  border-bottom: 2rpx solid #339dc8;
  color: #0084ba;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
}

.office-linked-item {
  padding: 16rpx 0;
}

.linked-title {
  color: #0084ba;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.45;
  word-break: break-word;
}

.linked-rank {
  display: flex;
  align-items: center;
  margin: 4rpx 0;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.rank-icon-small {
  width: 32rpx;
  height: 42rpx;
  margin-right: 4rpx;
  flex: 0 0 32rpx;
}

.linked-meta {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.4;
}

.office-plain-item {
  padding: 10rpx 0;
  color: #2d2d2d;
  font-size: 28rpx;
  line-height: 1.5;
}

.office-linked-item.dot,
.office-plain-item.dot {
  position: relative;
  padding-left: 25rpx;
}

.office-linked-item.dot::before,
.office-plain-item.dot::before {
  content: "";
  position: absolute;
  left: 3rpx;
  top: 29rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #0084ba;
}

.office-more {
  display: table;
  margin: 28rpx auto 0;
  padding: 12rpx 60rpx;
  border-radius: 40rpx;
  background: #0084ba;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
  letter-spacing: 1.5px;
  text-align: center;
}

.office-ad-list {
  margin: 58rpx 0 14rpx;
}

.office-ad-list.bottom {
  margin-top: 42rpx;
}

.office-ad {
  display: block;
  width: 600rpx;
  max-width: 100%;
  margin: 0 auto 38rpx;
  border: 2rpx solid #cccccc;
  box-sizing: border-box;
}

.office-bottom-banner {
  display: block;
  width: 100%;
  margin-top: 64rpx;
}

.profile-loading,
.profile-empty {
  min-height: 400rpx;
  padding: 100rpx 36rpx;
  color: #777777;
  font-size: 27rpx;
  text-align: center;
}
