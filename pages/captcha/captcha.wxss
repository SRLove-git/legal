.cap-page {
  padding: calc(88rpx + 100rpx) 48rpx 60rpx;
  background: #ffffff;
}

.cap-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #00558d;
  margin-bottom: 24rpx;
}

.cap-note {
  font-size: 27rpx;
  color: #555555;
  line-height: 1.6;
  margin-bottom: 18rpx;
}

.cap-note.small {
  font-size: 23rpx;
  color: #999999;
}

.cap-btn {
  margin-top: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #00558d;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 600;
  border-radius: 44rpx;
}
