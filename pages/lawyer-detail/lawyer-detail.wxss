.detail {
  padding: 30rpx 36rpx 60rpx;
}

.lawyer-updated {
  font-size: 24rpx;
  color: #777777;
  margin-bottom: 18rpx;
}

.lawyer-brief {
  display: flex;
  gap: 28rpx;
}

.lawyer-brief-info {
  flex: 1;
  min-width: 0;
}

.photo {
  width: 260rpx;
  height: 325rpx;
  border-radius: 12rpx;
  background: #edebeb;
  flex-shrink: 0;
}

.photo.placeholder {
  background: #edebeb;
}

.name {
  font-size: 40rpx;
  font-weight: 700;
  color: #00558d;
  line-height: 1.2;
}

.positions {
  margin-top: 18rpx;
}

.pos {
  display: inline-block;
  background: #0084ba;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 10rpx;
  padding: 12rpx 20rpx;
  margin: 0 16rpx 16rpx 0;
}

.firm {
  margin-top: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #2d2d2d;
}

.loc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #555555;
}

.bio {
  font-size: 28rpx;
  color: #2d2d2d;
  line-height: 1.6;
  white-space: pre-wrap;
}

.bio-rich {
  display: block;
  color: #303030;
  font-size: 32rpx;
  line-height: 1.5;
  overflow: hidden;
}

.lawyer-section {
  margin-top: 44rpx;
}

.lawyer-section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #00558d;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #00558d;
  margin-bottom: 20rpx;
}

.lawyer-list-item {
  font-size: 28rpx;
  color: #2d2d2d;
  line-height: 1.5;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f1f1f1;
}
