.detail {
  padding: 30rpx 36rpx 60rpx;
}

.photo {
  width: 320rpx;
  height: 400rpx;
  border-radius: 12rpx;
  background: #edebeb;
}

.photo.placeholder {
  background: #edebeb;
}

.name {
  margin-top: 26rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #0084ba;
}

.positions {
  margin-top: 18rpx;
}

.pos {
  display: inline-block;
  background: #0084ba;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 10rpx;
  padding: 12rpx 20rpx;
  margin: 0 16rpx 16rpx 0;
}

.firm {
  margin-top: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #2d2d2d;
}

.loc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #555555;
}

.bio {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #eeeeee;
  font-size: 28rpx;
  color: #2d2d2d;
  line-height: 1.65;
  white-space: pre-wrap;
}
