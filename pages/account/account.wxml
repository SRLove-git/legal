<site-header />
<view class="subpage" style="padding-top:calc(88rpx + {{statusBarHeight}}px);">
  <view class="breadcrumb">
    <image class="breadcrumb-icon" src="/assets/img/court-icon.png" />
    <text class="breadcrumb-sep">></text>
    <text class="breadcrumb-text">Account</text>
  </view>
  <view class="account">
    <view class="account-title">Account Settings</view>
    <view wx:if="{{loading}}" class="account-loading">Loading…</view>
    <block wx:else>
      <view class="account-row" wx:if="{{member.salutation || member.firstName || member.lastName}}">
        <text class="account-label">Name</text>
        <text class="account-value">{{member.salutation}} {{member.firstName}} {{member.lastName}}</text>
      </view>
      <view class="account-row" wx:if="{{member.businessEmail}}">
        <text class="account-label">Email</text>
        <text class="account-value">{{member.businessEmail}}</text>
      </view>
      <view class="account-row" wx:if="{{member.firmName}}">
        <text class="account-label">Organisation</text>
        <text class="account-value">{{member.firmName}}</text>
      </view>
      <view class="account-row" wx:if="{{member.position}}">
        <text class="account-label">Position</text>
        <text class="account-value">{{member.position}}</text>
      </view>
      <view class="account-row" wx:if="{{member.country || member.city}}">
        <text class="account-label">Location</text>
        <text class="account-value">{{member.city}} {{member.country}}</text>
      </view>
      <view class="account-row" wx:if="{{member.mobile}}">
        <text class="account-label">Mobile</text>
        <text class="account-value">{{member.mobileCode}} {{member.mobile}}</text>
      </view>
      <view class="account-menu">
        <view class="account-menu-item" bindtap="goAccess">Account access</view>
        <view class="account-menu-item" bindtap="goPassword">Change password</view>
        <view class="account-menu-item" bindtap="goSector">Change sector</view>
        <view class="account-menu-item" bindtap="goProfile">Update profile</view>
        <view class="account-menu-item" bindtap="goDashboard">Dashboard</view>
      </view>

      <button class="logout-btn" bindtap="doLogout">Sign out</button>
    </block>
  </view>
</view>
<site-footer />
