.account {
  padding: 40rpx 36rpx 80rpx;
}

.account-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #00558d;
  margin-bottom: 28rpx;
}

.account-loading {
  color: #999999;
  font-size: 28rpx;
}

.account-row {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eeeeee;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.account-label {
  font-size: 24rpx;
  color: #888888;
}

.account-value {
  font-size: 29rpx;
  color: #2d2d2d;
}

.logout-btn {
  margin-top: 40rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #00558d;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
}

.account-section {
  margin-top: 48rpx;
}

.account-section-head {
  font-size: 34rpx;
  font-weight: 700;
  color: #00558d;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #00558d;
  margin-bottom: 16rpx;
}

.account-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f1f1;
}

.account-item-title {
  font-size: 28rpx;
  color: #2d2d2d;
  line-height: 1.4;
}

.account-item-meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #777777;
}

.account-menu {
  margin-top: 44rpx;
  border-top: 1rpx solid #eeeeee;
}

.account-menu-item {
  padding: 30rpx 0;
  font-size: 29rpx;
  color: #2d2d2d;
  border-bottom: 1rpx solid #eeeeee;
}
