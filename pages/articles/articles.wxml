<site-header />
<view class="subpage" style="padding-top:calc(88rpx + {{statusBarHeight}}px);">
  <view class="breadcrumb">
    <image class="breadcrumb-icon" src="/assets/img/court-icon.png" bindtap="goHome" />
    <text class="breadcrumb-sep">></text>
    <text class="breadcrumb-text">Articles</text>
  </view>
  <view class="list-filters">SORT & FILTER</view>
  <view class="list-body">
  <view class="list-search-wrap">
    <input class="list-search-input" type="text" placeholder="Search articles" value="{{keyword}}" bindinput="onInput" bindconfirm="onSearch" confirm-type="search" />
  </view>
  <block wx:if="{{searching}}">
    <view class="list-heading"><view class="list-heading-dot"></view>Search results</view>
    <view class="list">
      <view class="list-entry" wx:for="{{results}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}" data-title="{{item.title}}">
        <view class="entry-labels" wx:if="{{item.labels.length}}">
          <text class="entry-label" wx:for="{{item.labels}}" wx:for-item="lb" wx:key="*this">{{lb}}</text>
        </view>
        <image class="entry-image" wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" />
        <view class="entry-title">{{item.title}}</view>
        <view class="entry-by" wx:if="{{item.author}}">By {{item.author}}</view>
        <view class="entry-date" wx:if="{{item.date}}">Updated: {{item.date}}</view>
      </view>
      <view class="list-end" wx:if="{{!results.length}}">No articles found</view>
    </view>
  </block>
  <block wx:else>
    <view class="article-section" wx:for="{{sections}}" wx:for-item="sec" wx:key="title">
      <view class="list-heading"><view class="list-heading-dot"></view>{{sec.title}}</view>
      <view class="list">
        <view class="list-entry" wx:for="{{sec.items}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}" data-title="{{item.title}}">
          <view class="entry-labels" wx:if="{{item.labels.length}}">
            <text class="entry-label" wx:for="{{item.labels}}" wx:for-item="lb" wx:key="*this">{{lb}}</text>
          </view>
          <image class="entry-image" wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" />
          <view class="entry-title">{{item.title}}</view>
          <view class="entry-by" wx:if="{{item.author}}">By {{item.author}}</view>
          <view class="entry-date" wx:if="{{item.date}}">Updated: {{item.date}}</view>
        </view>
      </view>
    </view>
  </block>
  </view>
</view>
<site-footer />
