.detail {
  padding: 30rpx 36rpx 60rpx;
}

.detail-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #00558d;
  line-height: 1.3;
}

.detail-badge {
  display: inline-block;
  background: #0084ba;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 8rpx;
  padding: 10rpx 20rpx;
  margin-top: 20rpx;
}

.detail-meta {
  margin-top: 18rpx;
  font-size: 25rpx;
  color: #777777;
}

.detail-body {
  margin-top: 30rpx;
  font-size: 28rpx;
  color: #2d2d2d;
  line-height: 1.65;
}
