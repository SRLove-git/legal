.detail {
  padding: 30rpx 36rpx 60rpx;
}

.detail-labels {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.detail-reference {
  font-size: 26rpx;
  color: #2d2d2d;
  padding: 6rpx 12rpx;
}

.detail-label {
  font-size: 20rpx;
  color: #555555;
  background: #f2f2f2;
  padding: 6rpx 12rpx;
  margin-left: 12rpx;
}

.detail-title {
  font-size: 57rpx;
  font-weight: 700;
  color: #2d2d2d;
  line-height: 1.05;
  margin: 19rpx 0 15rpx;
}

.detail-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 6rpx 0 38rpx;
  font-size: 22rpx;
  color: #2d2d2d;
}

.detail-rank {
  color: #0084ba;
  font-weight: 700;
}

.detail-banner {
  width: 100%;
  margin: 31rpx 0;
}

.detail-body {
  font-size: 31rpx;
  color: #303030;
  line-height: 46rpx;
  white-space: pre-wrap;
}

.detail-rich {
  display: block;
  color: #303030;
  font-size: 32rpx;
  line-height: 1.5;
  overflow: hidden;
}

.detail-block {
  margin-top: 40rpx;
}

.detail-block-head {
  font-size: 27rpx;
  font-weight: 700;
  color: #2d2d2d;
  margin-bottom: 10rpx;
}

.detail-block-value {
  font-size: 27rpx;
  color: #555555;
  line-height: 1.5;
}

.detail-related {
  font-size: 28rpx;
  color: #0084ba;
  line-height: 1.45;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f1f1f1;
}
