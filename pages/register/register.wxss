.form {
  padding: 40rpx 36rpx 80rpx;
}

.form-logo {
  width: 260rpx;
  margin: 10rpx auto 30rpx;
}

.form-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #00558d;
  margin-bottom: 30rpx;
}

.form-field {
  margin-bottom: 22rpx;
}

.form-input,
.form-picker {
  height: 88rpx;
  line-height: 88rpx;
  border: 2rpx solid #dddddd;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 29rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.form-hint {
  font-size: 23rpx;
  color: #999999;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.form-error {
  font-size: 25rpx;
  color: #c0392b;
  line-height: 1.45;
  margin-bottom: 18rpx;
}

.form-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #0084ba;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
}

.form-btn[disabled] {
  opacity: 0.7;
  color: #ffffff;
}

.form-links {
  margin-top: 26rpx;
  text-align: center;
}

.form-link {
  font-size: 25rpx;
  color: #0084ba;
}
