.list {
  padding: 0 36rpx 40rpx;
}

.ann-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #eeeeee;
}

.ann-type {
  font-size: 26rpx;
  font-weight: 600;
  color: #0084ba;
  margin-bottom: 12rpx;
}

.ann-headline {
  font-size: 30rpx;
  font-weight: 600;
