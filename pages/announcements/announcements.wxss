.list {
  padding: 0 36rpx 40rpx;
}

.ann-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #eeeeee;
}

.ann-type {
  display: inline-block;
  margin: 0 19rpx 12rpx 0;
  padding: 6rpx 12rpx;
  background: #f2f2f2;
  color: #555555;
  font-size: 21rpx;
  font-weight: 400;
}

.ann-image {
  display: block;
  width: 100%;
  height: 283rpx;
  margin: 7rpx 0 19rpx;
  background: #eef4f8;
}

.ann-headline {
  font-size: 30rpx;
  font-weight: 600;
  color: #0084ba;
  line-height: 1.4;
}

.ann-date {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #777777;
}
