<site-header />
<view class="subpage" style="padding-top:calc(88rpx + {{statusBarHeight}}px);">
  <view class="breadcrumb">
    <image class="breadcrumb-icon" src="https://www.legaloneglobal.com/images/court-icon-4@2x.png" bindtap="goHome" />
    <text class="breadcrumb-sep">></text>
    <text class="breadcrumb-text">Announcements</text>
  </view>
  <view class="list-body">
  <view class="list-heading"><view class="list-heading-dot"></view>Announcements</view>
  <view class="list-search-wrap">
    <input class="list-search-input" type="text" placeholder="Search announcements" value="{{keyword}}" bindinput="onInput" bindconfirm="onSearch" confirm-type="search" />
    <view class="search-icon" bindtap="onSearch"></view>
  </view>
  <view class="list">
    <view class="list-entry announcement-entry" wx:for="{{items}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}" data-url="{{item.url}}" data-headline="{{item.headline}}">
      <view class="entry-labels" wx:if="{{item.type}}">
        <text class="entry-label">{{item.type}}</text>
      </view>
      <image class="entry-image announcement-image" wx:if="{{item.image}}" src="{{item.image}}" mode="widthFix" />
      <view class="entry-title">{{item.headline}}</view>
      <view class="announcement-summary" wx:if="{{item.descript}}">{{item.descript}}</view>
      <view class="entry-date" wx:if="{{item.date}}">Updated: {{item.date}}</view>
      <view class="announcement-more">More detail</view>
    </view>
    <view class="list-end" wx:if="{{!items.length && !loading}}">No announcements found</view>
    <view class="list-end" wx:if="{{!hasMore && items.length}}">No more results</view>
  </view>
  <view class="announcement-learn-more-wrap" wx:if="{{hasMore}}">
    <view class="announcement-learn-more {{loading ? 'loading' : ''}}" bindtap="loadMore">
      {{loading ? 'Loading...' : 'Learn more'}}
    </view>
  </view>
  </view>
</view>
<site-footer />
