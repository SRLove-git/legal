page {
  background: #ffffff;
  color: #2d2d2d;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.2;
  letter-spacing: 1.2rpx;
}

view,
text,
scroll-view,
swiper,
swiper-item,
image,
input,
button {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: inherit;
}

button::after {
  border: none;
}

.container {
  padding-left: 36rpx;
  padding-right: 36rpx;
}

.link-blue {
  color: #0084ba;
}

.clearfix::after {
  content: "";
  display: block;
  clear: both;
}

.subpage {
  padding-top: calc(88rpx + 54px);
  min-height: 100vh;
}

.breadcrumb {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 36rpx;
  box-sizing: border-box;
  background-color: #00558d;
}

.breadcrumb-icon {
  width: 38rpx;
  height: 38rpx;
  flex-shrink: 0;
}

.breadcrumb-sep {
  padding: 0 28rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.breadcrumb-text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.breadcrumb-current {
  flex: 1;
  min-width: 0;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* List-page hero (deals / awards) */
.list-hero {
  position: relative;
  overflow: hidden;
  background-color: #2f5b86;
  padding: 54rpx 36rpx 68rpx;
  box-sizing: border-box;
}

.list-hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.list-hero-inner {
  position: relative;
  z-index: 2;
}

.list-hero-title {
  color: #ffffff;
  font-size: 54rpx;
  font-weight: 700;
  line-height: 58rpx;
  letter-spacing: 1rpx;
  text-transform: uppercase;
  margin-bottom: 26rpx;
}

.list-hero-title-line {
  display: block;
}

.list-hero-desc {
  color: #ffffff;
  font-size: 31rpx;
  line-height: 51rpx;
  padding-right: 92rpx;
}

.list-hero-actions {
  margin-top: 54rpx;
}

.list-hero-btn {
  display: inline-block;
  background: #0084ba;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 40rpx;
  padding: 23rpx 54rpx;
  border-radius: 54rpx;
}

/* SORT & FILTER bar */
.list-filters {
  background-color: #edebeb;
  color: #2d2d2d;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 37rpx;
  text-align: center;
  padding: 23rpx 0;
}

/* Section heading inside list pages */
.list-heading {
  display: flex;
  align-items: center;
  padding: 0 36rpx;
  color: #333333;
  font-size: 57rpx;
  font-weight: 700;
  line-height: 68rpx;
  margin-bottom: 28rpx;
}

.list-heading-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #0084ba;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.list-body {
  padding-top: 46rpx;
}

.subpage-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #00558d;
  padding: 36rpx 36rpx 20rpx;
  line-height: 1.25;
}

.subpage-lead {
  padding: 0 36rpx 36rpx;
  font-size: 28rpx;
  color: #2d2d2d;
  line-height: 1.55;
}

.subpage-section {
  padding: 28rpx 36rpx;
}

.subpage-section-heading {
  font-size: 34rpx;
  font-weight: 700;
  color: #00558d;
  margin-bottom: 20rpx;
}

.subpage-section-text {
  font-size: 27rpx;
  color: #2d2d2d;
  line-height: 1.55;
}

.legal-content {
  padding: 40rpx 36rpx 60rpx;
  font-size: 31rpx;
  color: #303030;
  line-height: 1.5;
  white-space: pre-wrap;
  word-break: break-word;
}

.list-page-item {
  display: block;
  padding: 26rpx 36rpx;
  border-bottom: 1rpx solid #eeeeee;
  font-size: 29rpx;
  color: #2d2d2d;
  line-height: 1.4;
}

.list-page-item.active {
  color: #0084ba;
  font-weight: 600;
}

.list-page-meta {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #777777;
  font-weight: 400;
}

.list-search-wrap {
  padding: 0 36rpx 20rpx;
}

.list-search-input {
  height: 76rpx;
  border: 2rpx solid #0084ba;
  border-radius: 38rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}

.list-end {
  text-align: center;
  color: #999999;
  font-size: 24rpx;
  padding: 30rpx 0;
}
